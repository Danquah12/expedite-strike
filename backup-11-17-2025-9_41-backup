@app.callback(
    [
        Output("metric-assets", "children"),
        Output("metric-services", "children"),
        Output("metric-vulns", "children"),
        Output("vuln-graph", "elements"),
        Output("vuln-table", "data"),
        Output("cvss-heatmap", "figure"),
        Output("last-updated", "children"),
    ],
    [
        Input("tabs", "value"),
        Input("nessus-refresh", "n_clicks"),
        Input("interval-refresh", "n_intervals"),
    ],
    prevent_initial_call=False
)
def update_vuln_dashboard(tab, refresh_clicks, n_intervals):
    from neo4j import GraphDatabase
    import plotly.express as px
    import pandas as pd
    from datetime import datetime

    if tab != "tab2" and not refresh_clicks and not n_intervals:
        raise PreventUpdate

    uri = "bolt://localhost:7687"
    user = "neo4j"
    password = "Adomaa12@"

    assets, services, vulns = set(), set(), set()
    nodes, edges, table_data = [], [], []

    driver = GraphDatabase.driver(uri, auth=(user, password))
    with driver.session() as session:
        q = """
        MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
        OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
        RETURN a.host AS asset, s.name AS service, s.port AS port,
               v.id AS vuln, v.cvss AS cvss, v.summary AS summary
        """
        results = session.run(q)

        for rec in results:
            a, s, p, v, cvss, summary = (
                rec["asset"],
                rec["service"],
                rec["port"],
                rec["vuln"],
                rec["cvss"],
                rec["summary"],
            )

            if a:
                assets.add(a)
                nodes.append({"data": {"id": a, "label": "Asset"}})
            if s:
                sid = f"{s}:{p}"
                services.add(s)
                nodes.append({"data": {"id": sid, "label": "Service"}})
                edges.append({"data": {"source": a, "target": sid}})
            if v:
                vulns.add(v)
                nodes.append({"data": {"id": v, "label": "Vulnerability"}})
                edges.append({"data": {"source": f"{s}:{p}", "target": v}})

                # Tooltip + link generation
                tooltip = f"CVSS {cvss or 0:.1f} — {summary[:100]}..." if summary else f"CVSS {cvss or 0:.1f}"
                v_link = f"[{v}](https://nvd.nist.gov/vuln/detail/{v})"

                # Severity mapping
                if not cvss or cvss == 0:
                    severity = "Informational"
                elif cvss >= 9.0:
                    severity = "Critical"
                elif cvss >= 7.0:
                    severity = "High"
                elif cvss >= 4.0:
                    severity = "Medium"
                else:
                    severity = "Low"

                table_data.append({
                    "Asset": a or "—",
                    "Service": s or "—",
                    "Port": p or "—",
                    "Vulnerability": (
                        f"{v_link} "
                        f"<span title='{tooltip}'>({severity})</span>"
                    )
                })

    driver.close()

    # Deduplicate nodes
    seen = {}
    for n in nodes:
        nid = n["data"]["id"]
        if nid not in seen:
            seen[nid] = n
    elements = list(seen.values()) + edges

    # CVSS Heatmap
    if table_data:
        df = pd.DataFrame(table_data)
        df["Severity"] = df["Vulnerability"].apply(
            lambda x: "Critical" if "Critical" in x else
                      "High" if "High" in x else
                      "Medium" if "Medium" in x else
                      "Low" if "Low" in x else
                      "Informational"
        )
        heatmap_fig = px.histogram(
            df, x="Service", color="Severity",
            title="Vulnerability Severity Distribution by Service",
            color_discrete_map={
                "Critical": "#ff073a",
                "High": "#ff8800",
                "Medium": "#ffc107",
                "Low": "#28a745",
                "Informational": "#17a2b8"
            }
        )
        heatmap_fig.update_layout(
            template="plotly_dark",
            paper_bgcolor="#111",
            plot_bgcolor="#111",
            font_color="white"
        )
    else:
        heatmap_fig = px.imshow([[0]], text_auto=True, title="No vulnerability data available")

    # --- Last Updated Timestamp ---
    timestamp = datetime.now().strftime("🕒 Last updated: %Y-%m-%d %H:%M:%S")

    return (
        str(len(assets)),
        str(len(services)),
        str(len(vulns)),
        elements,
        table_data,
        heatmap_fig,
        timestamp
    )


