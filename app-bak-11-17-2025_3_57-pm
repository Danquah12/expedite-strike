def get_system_health():
    cpu = psutil.cpu_percent(interval=0.5)
    mem = psutil.virtual_memory().percent
    disk = psutil.disk_usage("/").percent
    df = pd.DataFrame({
        "Metric": ["CPU Usage", "Memory Usage", "Disk Usage"],
        "Value": [cpu, mem, disk]
    })
    fig = px.bar(df, x="Metric", y="Value", title="System Health Overview", color="Value", range_y=[0,100])
    fig.update_layout(paper_bgcolor="#1C1C1C", plot_bgcolor="#1C1C1C", font_color="white")
    return fig

