def append_status(msg: str):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(STATUS_LOG, "a") as f:
        f.write(f"[{ts}] {msg}\n")

def call_openai(prompt: str) -> str:
    if not OPENAI_API_KEY:
        return "(Missing OPENAI_API_KEY in environment)"
    try:
        headers = {"Authorization": f"Bearer {OPENAI_API_KEY}", "Content-Type": "application/json"}
        data = {"model": "gpt-4o-mini", "messages": [{"role": "user", "content": prompt}]}
        resp = requests.post("https://api.openai.com/v1/chat/completions", headers=headers, json=data, timeout=30)
        rj = resp.json()
        return rj["choices"][0]["message"]["content"]
    except Exception as e:
        return f"OpenAI error: {e}"

def load_vuln_data():
    conn = sqlite3.connect(DB_PATH)
    df = pd.read_sql_query("SELECT id, host, port, service, title, severity, cvss, cve_id, source FROM findings", conn)
    conn.close()
    return df

