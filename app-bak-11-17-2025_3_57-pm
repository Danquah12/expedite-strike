@app.callback(
    Output("scan-status","children"),
    Input("start-scan-btn","n_clicks"),
    State("scanner-select","value"),
    State("target-ip","value"),
    State("upload-targets","contents"),
    prevent_initial_call=True
)
def trigger_scan(_, scanner, target_ip, upload_content):
    target_file = "/tmp/targets.txt"
    if upload_content:
        import base64
        content = upload_content.split(",")[1]
        Path(target_file).write_bytes(base64.b64decode(content))
    elif target_ip:
        Path(target_file).write_text(target_ip)
    else:
        return "❌ No targets provided."

    cmd = ""
    if scanner == "nmap":
        cmd = f"nmap -sV -T4 -A -v -iL {target_file} -oX /root/vuln_intel/feeds/nmap/live_scan.xml"
    elif scanner == "openvas":
        cmd = "gvm-cli socket --xml '<create_target>' ..."
    elif scanner == "burp":
        cmd = "echo 'Burp scan placeholder'"
    elif scanner == "nessus":
        cmd = "echo 'Nessus scan placeholder'"

    threading.Thread(target=lambda: subprocess.run(cmd, shell=True)).start()
    append_status(f"Started {scanner} scan on {target_file}")
    return f"🚀 {scanner} scan started on targets in {target_file}"

