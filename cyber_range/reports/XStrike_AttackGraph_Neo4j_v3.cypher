// EXPEDITE STRIKE V4 — Neo4j Attack Property Graph & BloodHound-Compatible Cypher Bundle
// Enforces Strict Per-Edge Evidence State Non-Inheritance: ChainState = min_stage(EdgeState)
CREATE CONSTRAINT xstrike_node_id IF NOT EXISTS FOR (n:XStrikeNode) REQUIRE n.node_id IS UNIQUE;
MERGE (n:XStrikeNode:AssessorSensor {node_id: 'NODE_ATTACKER_130'}) SET n.name = 'Assessor (192.168.195.130)', n.ip = '192.168.195.130';
MERGE (n:XStrikeNode:Host {node_id: 'NODE_HOST_192_168_195_139'}) SET n.name = '192.168.195.139 (Multi-Role Application & Database Server)', n.ip = '192.168.195.139';
MERGE (n:XStrikeNode:Host {node_id: 'NODE_HOST_192_168_195_140'}) SET n.name = '192.168.195.140 (Application & Web Middleware Server)', n.ip = '192.168.195.140';
