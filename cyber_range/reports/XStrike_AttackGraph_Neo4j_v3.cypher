MERGE (s:XStrikeNode {node_id: 'postgres_192_168_195_139_5432'}) SET s.name = 'postgres@192.168.195.139:5432' MERGE (t:XStrikeNode {node_id: 'PostgreSQL_Superuser_Role__rolsuper_true'}) SET t.name = 'PostgreSQL Superuser Role (rolsuper=true)' MERGE (s)-[r:EXECUTED_COMPROMISE {chain_id: 'CHAIN-04', stage: 3, finding_id: 'F-03'}]->(t) SET r.technique_id = 'T1078', r.validation_state = 'CONFIRMED_EXECUTED', r.evidence_ref = 'PROV-F-03-5EBB5E02B0', r.confidence = 95.0;
MERGE (s:XStrikeNode {node_id: 'PostgreSQL_Superuser_Role__rolsuper_true'}) SET s.name = 'PostgreSQL Superuser Role (rolsuper=true)' MERGE (t:XStrikeNode {node_id: 'pg_catalog___template1___postgres_Databa'}) SET t.name = 'pg_catalog / template1 / postgres Databases' MERGE (s)-[r:EXECUTED_COMPROMISE {chain_id: 'CHAIN-04', stage: 4, finding_id: 'F-03'}]->(t) SET r.technique_id = 'T1005', r.validation_state = 'CONFIRMED_EXECUTED', r.evidence_ref = 'PROV-F-03-5EBB5E02B0', r.confidence = 95.0;
MERGE (s:XStrikeNode {node_id: 'Assessor__192_168_195_130_'}) SET s.name = 'Assessor (192.168.195.130)' MERGE (t:XStrikeNode {node_id: '192_168_195_139_2049__NFS_____80__HTTP_'}) SET t.name = '192.168.195.139:2049 (NFS) & :80 (HTTP)' MERGE (s)-[r:EXECUTED_COMPROMISE {chain_id: 'CHAIN-05', stage: 1, finding_id: 'F-39'}]->(t) SET r.technique_id = 'T1190', r.validation_state = 'CONFIRMED_EXECUTED', r.evidence_ref = 'PROV-F-39-D5CCEDCEC8', r.confidence = 92.0;
MERGE (s:XStrikeNode {node_id: '192_168_195_139_2049____80'}) SET s.name = '192.168.195.139:2049 & :80' MERGE (t:XStrikeNode {node_id: 'Exported_NFS_Share___Mutillidae_SQLi___D'}) SET t.name = 'Exported NFS Share & Mutillidae SQLi / DVWA Admin' MERGE (s)-[r:VALIDATED_PRECONDITION {chain_id: 'CHAIN-05', stage: 2, finding_id: 'F-08'}]->(t) SET r.technique_id = 'T1190', r.validation_state = 'PARTIALLY_VALIDATED', r.evidence_ref = 'PROV-F-08-9CC3744D82', r.confidence = 88.0;
MERGE (s:XStrikeNode {node_id: 'Exported_NFS_Share'}) SET s.name = 'Exported NFS Share' MERGE (t:XStrikeNode {node_id: 'Root_Filesystem_Write___SSH_authorized_k'}) SET t.name = 'Root Filesystem Write / SSH authorized_keys Injection' MERGE (s)-[r:INFERRED_LATERAL_CANDIDATE {chain_id: 'CHAIN-05', stage: 3, finding_id: 'F-39'}]->(t) SET r.technique_id = 'T1098.004', r.validation_state = 'INFERRED_NOT_EXECUTED', r.evidence_ref = 'PROV-F-39-D5CCEDCEC8', r.confidence = 78.0;
MERGE (s:XStrikeNode {node_id: 'Root_Filesystem_Write___SSH_authorized_k'}) SET s.name = 'Root Filesystem Write / SSH authorized_keys Injection' MERGE (t:XStrikeNode {node_id: '192_168_195_139__Projected_Host_Takeover'}) SET t.name = '192.168.195.139 (Projected Host Takeover / DB Extraction)' MERGE (s)-[r:INFERRED_LATERAL_CANDIDATE {chain_id: 'CHAIN-05', stage: 4, finding_id: 'F-39'}]->(t) SET r.technique_id = 'T1005', r.validation_state = 'INFERRED_NOT_EXECUTED', r.evidence_ref = 'PROV-F-39-D5CCEDCEC8', r.confidence = 75.0;
