MERGE (s:XStrikeNode {node_id: '192_168_195_1____130____140__TCP_Port_44'}) SET s.name = '192.168.195.1 / .130 / .140 (TCP Port 445)' MERGE (t:XStrikeNode {node_id: 'Unverified_SMBv1___Lateral_Movement_Cand'}) SET t.name = 'Unverified SMBv1 / Lateral Movement Candidate' MERGE (s)-[r:INFERRED_LATERAL_CANDIDATE {chain_id: 'CHAIN-06', stage: 2, finding_id: 'F-53'}]->(t) SET r.technique_id = 'T1210', r.validation_state = 'INFERRED_NOT_EXECUTED', r.evidence_ref = 'PROV-F-53-483C65504D', r.confidence = 25.0;

// CYPHER-01: Verified End-to-End Root Compromise Paths Only (Strict Edge-State Filter)
// Returns only attack chains where EVERY hop in the path has validation_state = 'CONFIRMED_EXECUTED' (never inherits executed status onto inferred hops).
MATCH p = (src:XStrikeNode)-[:EXECUTED_COMPROMISE*1..4]->(dst:XStrikeNode)
WHERE ALL(r IN relationships(p) WHERE r.validation_state = 'CONFIRMED_EXECUTED')
  AND dst.name CONTAINS 'uid=0'
RETURN p, [r IN relationships(p) | r.finding_id] AS findings, [r IN relationships(p) | r.evidence_ref] AS proofs;

// CYPHER-02: Hybrid / Partially Validated Chains with Unexecuted Escalation or Pivot Hops
// Identifies chains (such as CHAIN-03 SSH->SUID and CHAIN-05 NFS/SQLi) that start with an executed foothold but transition into a validated or inferred step.
MATCH p = (src:XStrikeNode)-[r1:EXECUTED_COMPROMISE]->(mid:XStrikeNode)-[r2:VALIDATED_PRECONDITION|INFERRED_LATERAL_CANDIDATE*1..3]->(dst:XStrikeNode)
RETURN r1.chain_id AS chain, mid.name AS foothold_boundary, [rel IN r2 | rel.validation_state] AS downstream_states;

// CYPHER-03: Betweenness Centrality & Choke-Point Remediation ROI Ranking
// Computes which remediation control node (e.g., 192.168.195.139:1524, :21, :22, :5432) severs the maximum number of active attack chains.
MATCH (s:XStrikeNode)-[r]->(t:XStrikeNode)
RETURN r.finding_id AS finding_id, t.name AS choke_point_node, count(DISTINCT r.chain_id) AS chains_severed, collect(DISTINCT r.chain_id) AS chains
ORDER BY chains_severed DESC;

