MERGE (s:XStrikeNode {node_id: 'msfadmin_192_168_195_139__uid_1000_'}) SET s.name = 'msfadmin@192.168.195.139 (uid=1000)' MERGE (t:XStrikeNode {node_id: 'SUID__usr_bin_nmap___DirtyCow__CVE_2016_'}) SET t.name = 'SUID /usr/bin/nmap & DirtyCow (CVE-2016-5195) Vector' MERGE (s)-[r:VALIDATED_PRECONDITION {chain_id: 'CHAIN-03', stage: 3, finding_id: 'F-06'}]->(t) SET r.technique_id = 'T1548.001', r.validation_state = 'PARTIALLY_VALIDATED', r.evidence_ref = 'PROV-F-06-E061A6DE7E', r.confidence = 88.0;
MERGE (s:XStrikeNode {node_id: 'SUID__usr_bin_nmap___DirtyCow__CVE_2016_'}) SET s.name = 'SUID /usr/bin/nmap & DirtyCow (CVE-2016-5195) Vector' MERGE (t:XStrikeNode {node_id: 'root_192_168_195_139__Projected_Escalati'}) SET t.name = 'root@192.168.195.139 (Projected Escalation)' MERGE (s)-[r:INFERRED_LATERAL_CANDIDATE {chain_id: 'CHAIN-03', stage: 4, finding_id: 'F-06'}]->(t) SET r.technique_id = 'T1068', r.validation_state = 'INFERRED_NOT_EXECUTED', r.evidence_ref = 'PROV-F-06-E061A6DE7E', r.confidence = 84.0;
MERGE (s:XStrikeNode {node_id: 'Assessor__192_168_195_130_'}) SET s.name = 'Assessor (192.168.195.130)' MERGE (t:XStrikeNode {node_id: '192_168_195_139_5432__PostgreSQL_8_3_1_'}) SET t.name = '192.168.195.139:5432 (PostgreSQL 8.3.1)' MERGE (s)-[r:EXECUTED_COMPROMISE {chain_id: 'CHAIN-04', stage: 1, finding_id: 'F-03'}]->(t) SET r.technique_id = 'T1190', r.validation_state = 'CONFIRMED_EXECUTED', r.evidence_ref = 'PROV-F-03-5EBB5E02B0', r.confidence = 95.0;
