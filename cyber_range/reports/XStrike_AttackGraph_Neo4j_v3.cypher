MERGE (s:XStrikeNode {node_id: 'root_192_168_195_139__uid_0_'}) SET s.name = 'root@192.168.195.139 (uid=0)' MERGE (t:XStrikeNode {node_id: '192_168_195_139___etc_shadow___Full_Host'}) SET t.name = '192.168.195.139 (/etc/shadow & Full Host Control)' MERGE (s)-[r:EXECUTED_COMPROMISE {chain_id: 'CHAIN-01', stage: 4, finding_id: 'F-02'}]->(t) SET r.technique_id = 'T1003.008', r.validation_state = 'CONFIRMED_EXECUTED', r.evidence_ref = 'PROV-F-02-1355D17556', r.confidence = 99.0;
MERGE (s:XStrikeNode {node_id: 'Assessor__192_168_195_130_'}) SET s.name = 'Assessor (192.168.195.130)' MERGE (t:XStrikeNode {node_id: '192_168_195_139_1524__ingreslock_'}) SET t.name = '192.168.195.139:1524 (ingreslock)' MERGE (s)-[r:EXECUTED_COMPROMISE {chain_id: 'CHAIN-02', stage: 1, finding_id: 'F-01'}]->(t) SET r.technique_id = 'T1190', r.validation_state = 'CONFIRMED_EXECUTED', r.evidence_ref = 'PROV-F-01-020BA0B28F', r.confidence = 99.0;
