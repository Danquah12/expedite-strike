def _run_osint_bg(target: str, target_type: str, scope: list[str]):
    results: dict[str, list] = {k: [] for k in _OSINT_RESULTS}
    dns_data = {}
    whois_data = ""

    # Passive DNS & WHOIS (always run for domain)
    if target_type in ("domain", "ip") and "passive" in scope:
        dns_data = _fetch_dns(target)
        whois_data = _fetch_whois(target)

    # Subdomains via crt.sh
    if target_type == "domain" and "passive" in scope:
        results["subdomains"] = _fetch_subdomains_crt(target)

    # Wayback
    if target_type == "domain" and "passive" in scope:
        results["ips"] = _fetch_wayback_urls(target)[:50]

    # Email harvest via Hunter.io
    if target_type in ("domain",) and "passive" in scope:
        results["emails"] = _fetch_hunter_emails(target)

    # HIBP breach check
    if target_type == "email" and "breach" in scope:
        results["breaches"] = _fetch_hibp(target)
    elif target_type == "domain" and "breach" in scope:
        results["breaches"] = [{"breach": "Enter email address to check HaveIBeenPwned",
                                  "date": "", "count": 0}]

    # Shodan
    if target_type in ("domain", "ip") and "passive" in scope:
        results["shodan"] = _shodan_lookup(target)

    # Username check
    if target_type == "username" and "social" in scope:
        results["social"] = _username_check(target)

    with _LOCK:
        _OSINT_RESULTS.update(results)
        _CMD_OUTPUTS["dns"]   = json.dumps(dns_data, indent=2)
        _CMD_OUTPUTS["whois"] = whois_data
        _CMD_OUTPUTS["done"]  = "1"


@callback(
    Output("osint-results",      "data"),
    Output("osint-status",       "children"),
    Output("osint-stats-bar",    "children"),
    Output("osint-target",       "data"),
    Output("osint-traffic-light","style"),
    Output("osint-traffic-label","children"),
    Output("osint-poll",         "disabled"),
    Input("osint-run-btn",  "n_clicks"),
    State("osint-target-input","value"),
    State("osint-target-type", "value"),
    State("osint-scope",       "value"),
    prevent_initial_call=True,
)
def run_osint(n, target, target_type, scope):
    _LIGHT_RUNNING = {
        "display": "inline-block", "width": "12px", "height": "12px",
        "borderRadius": "50%", "background": "#e74c3c",
        "marginRight": "8px", "verticalAlign": "middle",
        "boxShadow": "0 0 8px 3px #e74c3c",
        "animation": "osint-blink 0.8s ease-in-out infinite",
    }
    _LIGHT_DONE = {
        "display": "inline-block", "width": "12px", "height": "12px",
        "borderRadius": "50%", "background": "#00c88c",
        "marginRight": "8px", "verticalAlign": "middle",
        "boxShadow": "0 0 8px 3px #00c88c",
        "animation": "none",
    }
    if not n or not target:
        raise PreventUpdate
    target = target.strip()
    scope  = scope or ["passive"]

    import uuid
    scan_id = str(uuid.uuid4())[:8]

    # Reset scan state
    with _LOCK:
        _SCAN_STATE.update({
            "running": True,
            "done":    False,
            "scan_id": scan_id,
            "steps":   [],
            "results": {},
        })
        _OSINT_RESULTS.update({k: [] for k in _OSINT_RESULTS})

    # ── Background worker ─────────────────────────────────────────
    def _do_scan():
        results: dict[str, Any] = {k: [] for k in _OSINT_RESULTS}
        dns_data:  dict = {}
        whois_raw: str  = ""

        try:
            # DNS
            if target_type in ("domain", "ip") and "passive" in scope:
                _log_step("🌐", f"Resolving DNS records for {target}…")
                dns_data = _fetch_dns(target)
                n_dns = sum(len(v) for v in dns_data.values())
                _log_step("🌐", f"DNS complete — {n_dns} records found", ok=True)

            # WHOIS
            if target_type in ("domain", "ip") and "passive" in scope:
                _log_step("📝", f"Fetching WHOIS for {target}…")
                whois_raw = _fetch_whois(target)
                _log_step("📝", "WHOIS retrieved", ok=True)

            # Subdomains via crt.sh
            if target_type == "domain" and "passive" in scope:
                _log_step("📡", f"Enumerating subdomains via crt.sh…")
                try:
                    r = requests.get(
                        f"https://crt.sh/?q=%.{target}&output=json",
                        timeout=20, headers={"User-Agent": "OSINT-Dashboard/1.0"}
                    )
                    if r.status_code == 200:
                        data = r.json()
                        subs = sorted({
                            entry.get("name_value", "").replace("*.", "").lower()
                            for entry in data
                            if target in entry.get("name_value", "")
                        })
                        results["subdomains"] = subs[:100]
                        _log_step("📡", f"Subdomains: {len(results['subdomains'])} found", ok=True)
                    else:
                        _log_step("📡", "crt.sh returned no results", ok=False)
                except Exception as e:
                    results["subdomains"] = []
                    _log_step("📡", f"Subdomain enum failed: {e}", ok=False)

            # Wayback Machine
            if target_type == "domain" and "passive" in scope:
                _log_step("📁", "Querying Wayback Machine for archived URLs…")
                try:
                    r = requests.get(
                        f"http://web.archive.org/cdx/search/cdx?url=*.{target}/*"
                        f"&output=json&fl=original&collapse=urlkey&limit=50",
                        timeout=15
                    )
                    if r.status_code == 200:
                        data = r.json()
                        results["ips"] = [row[0] for row in data[1:] if row][:50]
                        _log_step("📁", f"Wayback: {len(results['ips'])} archived URLs", ok=True)
                    else:
                        _log_step("📁", "Wayback returned no results", ok=False)
                except Exception:
                    results["ips"] = []
                    _log_step("📁", "Wayback query failed", ok=False)

            # InternetDB
            if target_type == "domain" and "passive" in scope:
                a_ips = dns_data.get("A", []) + dns_data.get("AAAA", [])
                if a_ips:
                    _log_step("🖥️", f"InternetDB scan for {len(a_ips)} IP(s)…")
                    results["internetdb"] = _fetch_internetdb(a_ips)
                    _log_step("🖥️", f"InternetDB: {len(results['internetdb'])} hosts with data", ok=True)

            # Email harvest
            if target_type == "domain" and "passive" in scope:
                _log_step("📧", "Harvesting email addresses…")
                dns_txt = dns_data.get("TXT", [])
                results["emails"] = _fetch_hunter_emails(target, whois_raw, dns_txt)
                n_e = len([e for e in results["emails"] if "@" in e.get("email", "")])
                _log_step("📧", f"Emails: {n_e} addresses found", ok=True)

            # Breach check
            if target_type == "email" and "breach" in scope:
                _log_step("🔓", f"Checking {target} against HaveIBeenPwned…")
                results["breaches"] = _fetch_hibp(target)
                _log_step("🔓", f"Breach check: {len(results['breaches'])} records", ok=True)
            elif target_type == "domain" and "breach" in scope:
                _log_step("🔓", f"Searching breach databases for @{target}…")
                results["breaches"] = _fetch_domain_breaches(target)
                n_br = len([b for b in results["breaches"] if b.get("count", 0) > 0])
                _log_step("🔓", f"Breach DB: {len(results['breaches'])} sources checked, {n_br} hits", ok=True)

            # Shodan
            if target_type in ("domain", "ip") and "passive" in scope:
                _log_step("🔍", "Querying Shodan for exposed services…")
                results["shodan"] = _shodan_lookup(target)
                _log_step("🔍", f"Shodan: {len(results['shodan'])} service(s)", ok=True)

            # Social checks
            if target_type == "username" and "social" in scope:
                _log_step("👥", f"Checking username '{target}' across platforms…")
                results["social"] = _username_check(target)
                n_s = len([s for s in results["social"] if s.get("found")])
                _log_step("👥", f"Social: {n_s} profiles confirmed", ok=True)
            elif target_type == "domain" and "social" in scope:
                _log_step("👥", "Checking organisation social media presence…")
                results["social"] = _fetch_org_social(target)
                n_s = len([s for s in results["social"] if s.get("found")])
                _log_step("👥", f"Social: {n_s} platforms confirmed", ok=True)

            # Persist
            with _LOCK:
                _OSINT_RESULTS.update(results)
                _CMD_OUTPUTS["dns"]   = json.dumps(dns_data, indent=2)
                _CMD_OUTPUTS["whois"] = whois_raw

            results["_dns_raw"]   = json.dumps(dns_data, indent=2)
            results["_whois_raw"] = whois_raw

            _log_step("✅", f"OSINT complete for {target}")

        except Exception as ex:
            _log_step("❌", f"Scan error: {ex}", ok=False)

        finally:
            with _LOCK:
                _SCAN_STATE["running"] = False
                _SCAN_STATE["done"]    = True
                _SCAN_STATE["results"] = results

    threading.Thread(target=_do_scan, daemon=True).start()

    # Return immediately — interval will poll for updates
    return (
        {},          # results (empty until done)
        f"🔄 Scanning {target}…",  # status
        html.Div(),  # stats bar (empty until done)
        target,      # target store
        _LIGHT_RUNNING,
        f"🔴 Running — {target}",
        False,       # interval disabled=False
    )




# ── Interval: poll scan progress + finalize results ────────────────────────

def _build_activity_feed(steps: list) -> list:
    """Turn a list of step dicts into Dash Div elements."""
    if not steps:
        return [html.Div("⏳ Initialising…",
                         style={"color": "#8e9eb0", "fontSize": "11px"})]
    rows = []
    for s in steps:
        color = "#00c88c" if s.get("ok", True) else "#e74c3c"
        rows.append(html.Div([
            html.Span(s["ts"],
                      style={"color": "#4a5568", "fontSize": "9px",
                             "marginRight": "6px", "fontFamily": "monospace"}),
            html.Span(s["icon"] + " ",
                      style={"fontSize": "11px", "marginRight": "3px"}),
            html.Span(s["text"],
                      style={"color": color, "fontSize": "11px"}),
        ], style={"padding": "2px 0", "borderBottom": "1px solid #111317"}))
    return rows


@callback(
    Output("osint-results",       "data",     allow_duplicate=True),
    Output("osint-status",        "children", allow_duplicate=True),
    Output("osint-stats-bar",     "children", allow_duplicate=True),
    Output("osint-traffic-light", "style",    allow_duplicate=True),
    Output("osint-traffic-label", "children", allow_duplicate=True),
    Output("osint-activity-feed", "children"),
    Output("osint-poll",          "disabled"),
    Input("osint-poll",  "n_intervals"),
    prevent_initial_call=True,
)
def poll_osint_progress(n):
    _LIGHT_RUNNING = {
        "display": "inline-block", "width": "12px", "height": "12px",
        "borderRadius": "50%", "background": "#e74c3c",
        "marginRight": "8px", "verticalAlign": "middle",
        "boxShadow": "0 0 8px 3px #e74c3c",
        "animation": "osint-blink 0.8s ease-in-out infinite",
    }
    _LIGHT_DONE = {
        "display": "inline-block", "width": "12px", "height": "12px",
        "borderRadius": "50%", "background": "#00c88c",
        "marginRight": "8px", "verticalAlign": "middle",
        "boxShadow": "0 0 8px 3px #00c88c",
        "animation": "none",
    }

    with _LOCK:
        running = _SCAN_STATE["running"]
        done    = _SCAN_STATE["done"]
        steps   = list(_SCAN_STATE["steps"])
        results = dict(_SCAN_STATE.get("results", {}))

    feed = _build_activity_feed(steps)

    if not done:
        # Still running — keep blinking, update feed
        last = steps[-1]["text"] if steps else "Starting…"
        return (
            {},
            f"🔄 {last}",
            html.Div(),
            _LIGHT_RUNNING,
            f"🔴 Running",
            feed,
            False,   # keep interval active
        )

    # ── Scan finished — build final UI ──────────────────────────────────
    target = results.get("_target", "")
    n_subs   = len(results.get("subdomains", []))
    n_emails = len([e for e in results.get("emails", []) if "@" in e.get("email", "")])
    n_breach = len(results.get("breaches", []))
    n_social = len([s for s in results.get("social", []) if s.get("found")])
    n_shodan = len(results.get("shodan", []))

    stats = html.Div([
        _stat_pill("Subdomains", str(n_subs),   "#3498db"),
        _stat_pill("Emails",     str(n_emails),  "#f39c12"),
        _stat_pill("Breaches",   str(n_breach),  "#e74c3c"),
        _stat_pill("Social Hits",str(n_social),  "#9b59b6"),
        _stat_pill("Shodan IPs", str(n_shodan),  "#1abc9c"),
    ], style={"marginBottom": "4px"})

    status_msg = f"✅ OSINT complete — {n_subs} subdomains, {n_emails} emails"

    return (
        results,
        status_msg,
        stats,
        _LIGHT_DONE,
        f"✅ Done",
        feed,
        True,   # disable interval
    )


