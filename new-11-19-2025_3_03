# ----------------------------------------------------------
# 2.1 — Initialize Database (Findings + Services)
# ----------------------------------------------------------
def init_database():
    """Create required tables if they do not exist."""
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    # Primary Findings Table (used by main dashboard)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS findings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            asset TEXT,
            port INTEGER,
            service TEXT,
            version TEXT,
            cve TEXT,
            severity TEXT,
            cvss REAL,
            cpe TEXT,
            description TEXT
        )
    """)

    # Services Table (raw Nmap results)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS services (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            asset_ip TEXT,
            hostname TEXT,
            port TEXT,
            protocol TEXT,
            state TEXT,
            service TEXT,
            product TEXT,
            version TEXT
        )
    """)

    conn.commit()
    conn.close()
    print("✅ SQLite initialized")


# ----------------------------------------------------------
# 2.2 — Parse Nmap XML Output
# ----------------------------------------------------------
def parse_nmap_xml(xml_path):
    """Parse Nmap XML and return structured Python results."""
    if not os.path.exists(xml_path):
        return []

    results = []

    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()

        for host in root.findall("host"):
            address = host.find("address").get("addr")

            # hostname
            hostname_tag = host.find("hostnames/hostname")
            hostname = hostname_tag.get("name") if hostname_tag is not None else None

            # ports
            for port in host.findall("ports/port"):
                port_id = port.get("portid")
                proto = port.get("protocol")
                state = port.find("state").get("state")

                svc = port.find("service")
                service_name = svc.get("name") if svc is not None else ""
                product = svc.get("product") if svc is not None else ""
                version = svc.get("version") if svc is not None else ""

                results.append({
                    "ip": address,
                    "hostname": hostname,
                    "port": port_id,
                    "protocol": proto,
                    "state": state,
                    "service": service_name,
                    "product": product,
                    "version": version
                })
    except Exception as e:
        print(f"❌ XML Parse Error: {e}")
        return []

    return results


# ----------------------------------------------------------
# 2.3 — Save XML Scan Results → SQLite
# ----------------------------------------------------------
def save_scan_to_database(parsed_results):
    """Save parsed XML results into SQLite services table."""
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()

        for r in parsed_results:
            cur.execute("""
                INSERT INTO services (
                    asset_ip, hostname, port, protocol, state, service, product, version
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                r.get("ip"),
                r.get("hostname"),
                r.get("port"),
                r.get("protocol"),
                r.get("state"),
                r.get("service"),
                r.get("product"),
                r.get("version"),
            ))

        conn.commit()
        conn.close()

        print(f"✅ Saved {len(parsed_results)} service records to DB")

    except Exception as e:
        print(f"❌ SQLite Insert Error: {e}")
        return False

    return True


