def run_graph_query(category, graph_type):
    """
    Executes the correct Neo4j query based on graph_type.
    Returns a list of nodes + edges ready for Cytoscape.
    """

    uri = "bolt://localhost:7687"
    user = "neo4j"
    password = "Adomaa12@"

    try:
        driver = GraphDatabase.driver(uri, auth=(user, password))
        session = driver.session()

        print(f"[GRAPH] Running: {graph_type}")

        # ==============================
        # CORE RELATIONSHIP GRAPHS
        # ==============================
        if graph_type == "Asset-Service-Vulnerability Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, s.name AS service, s.port AS port,
                   v.id AS vuln;
            """

        elif graph_type == "Service-Port Graph":
            q = """
            MATCH (s:Service)
            RETURN s.name AS service, s.port AS port;
            """

        elif graph_type == "Asset-Vulnerability Impact Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, v.id AS vuln, v.cvss AS cvss;
            """

        # ==============================
        # NETWORK TOPOLOGY
        # ==============================
        elif graph_type == "Network Topology Map":
            q = """
            MATCH (a:Asset)-[:CONNECTED_TO]->(b:Asset)
            RETURN a.host AS src, b.host AS dst;
            """

        elif graph_type == "Subnet Communication Graph":
            q = """
            MATCH (a:Asset)-[:CONNECTED_TO]->(b:Asset)
            RETURN a.subnet AS subnetA, b.subnet AS subnetB;
            """

        # ==============================
        # EXPOSURE / VULNERABILITY
        # ==============================
        elif graph_type == "Critical Asset Exposure Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            WHERE v.cvss >= 9.0
            RETURN a.host AS asset, v.id AS vuln, v.cvss AS cvss;
            """

        elif graph_type == "Vulnerability Cluster Graph":
            q = """
            MATCH (v:Vulnerability)<-[:HAS_VULNERABILITY]-(:Service)-[:RUNS_SERVICE]->(a:Asset)
            RETURN v.id AS vuln, a.host AS asset;
            """

        # ==============================
        # ATTACK PATHS
        # ==============================
        elif graph_type == "Potential Attack Paths":
            q = """
            MATCH p = (a:Asset)-[:RUNS_SERVICE]->(:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN p LIMIT 50;
            """

        elif graph_type == "Privilege Escalation Graph":
            q = """
            MATCH p = (u:User)-[:HAS_PRIV]->(p1:Privilege)-[:ESCALATES_TO]->(p2:Privilege)
            RETURN p LIMIT 50;
            """

        # ==============================
        # DEFAULT (failsafe)
        # ==============================
        else:
            return [], [], f"⚠️ No query defined for graph type: {graph_type}"

        # RUN QUERY
        results = session.run(q)

        nodes = {}
        edges = []

        # PARSE OUTPUT → Cytoscape
        for record in results:
            for key, val in record.items():

                # Nodes
                if val and key != "port" and key != "cvss":
                    if val not in nodes:
                        nodes[val] = {"data": {"id": val, "label": val}}

            # Edges
            keys = list(record.keys())
            if len(keys) >= 2:
                src = record[keys[0]]
                dst = record[keys[1]]
                if src and dst:
                    edges.append({"data": {"source": src, "target": dst}})

        driver.close()

        return list(nodes.values()) + edges, f"✅ Loaded {len(nodes)} nodes and {len(edges)} edges."

    except Exception as e:
        print("Graph Query Error:", e)
        return [], f"❌ Neo4j query failed: {e}"


