# ==========================================================
#  PART 9 — NEO4J GRAPH PERFORMANCE BOOST SUITE
#  (Large Graph Protection + Faster Rendering)
# ==========================================================

# Max allowed nodes to protect browser memory
MAX_GRAPH_NODES = 1500

# Timeout for heavy queries
NEO4J_QUERY_TIMEOUT_MS = 8000  # 8 seconds


# ----------------------------------------------------------
# 9.1 — Safe Query Execution Wrapper (Timeout + Error)
# ----------------------------------------------------------
def safe_neo4j_run(driver, cypher):
    try:
        with driver.session() as session:
            result = session.run(
                cypher,
                timeout=NEO4J_QUERY_TIMEOUT_MS
            )
            return list(result), None

    except Exception as e:
        return None, f"⚠️ Neo4j Query Failed: {str(e)}"


# ----------------------------------------------------------
# 9.2 — Graph Compression (Cluster Large Graphs)
# ----------------------------------------------------------
def compress_large_graph(nodes, edges):
    """
    If graph exceeds MAX_GRAPH_NODES — we replace clusters with
    abstracted 'GROUP-N' nodes instead of failing.
    """

    if len(nodes) <= MAX_GRAPH_NODES:
        return nodes, edges, None

    # Compute compression
    factor = max(2, len(nodes) // MAX_GRAPH_NODES)
    compressed_nodes = []
    compressed_edges = []

    group_map = {}

    for i, node in enumerate(nodes):
        group_id = i // factor
        label = f"Group-{group_id}"

        if label not in group_map:
            compressed_nodes.append({
                "data": {"id": label, "label": label},
                "classes": "group-node"
            })
            group_map[label] = True

    # Edges compressed to abstract relationships
    for i, edge in enumerate(edges):
        group_from = f"Group-{i // factor}"
        group_to = f"Group-{(i+1) // factor}"

        if group_from != group_to:
            compressed_edges.append({
                "data": {"source": group_from, "target": group_to}
            })

    msg = (
        f"⚠️ Graph too large ({len(nodes)} nodes). "
        f"Compressed into {len(compressed_nodes)} groups."
    )

    return compressed_nodes, compressed_edges, msg


