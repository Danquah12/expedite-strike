def run_neo4j_graph_query(query_text):
    """
    Runs a Neo4j Cypher query and returns raw records.
    """
    try:
        driver = GraphDatabase.driver("bolt://localhost:7687",
                                      auth=("neo4j", "Adomaa12@"))

        with driver.session() as session:
            result = session.run(query_text)
            data = list(result)

        driver.close()
        return data, None

    except Exception as e:
        return None, f"Neo4j Error: {str(e)}"


# ----------------------------------------------------------
# 6.1 — Convert Neo4j Result → Cytoscape Nodes/Edges
# ----------------------------------------------------------
def neo4j_to_cytoscape(records):
    """
    Takes Neo4j records (list of dicts) and converts to Cytoscape format.
    Handles nodes, edges, paths, and variable-length results.
    """

    nodes = {}
    edges = []

    if not records:
        return [], "⚠️ No results from Neo4j."

    for rec in records:
        for value in rec.values():

            # -----------------------
            # If data is a PATH
            # -----------------------
            if hasattr(value, "nodes"):
                for i, node in enumerate(value.nodes):

                    node_id = str(node.element_id)
                    nodes[node_id] = {
                        "data": {
                            "id": node_id,
                            "label": list(node.labels)[0] if node.labels else "Node",
                            **dict(node)  # properties
                        }
                    }

                    # edges inside path
                    if i < len(value.relationships):
                        rel = value.relationships[i]
                        edges.append({
                            "data": {
                                "source": str(rel.start_node.element_id),
                                "target": str(rel.end_node.element_id),
                                "label": rel.type
                            }
                        })

            # -----------------------
            # If data is a NODE
            # -----------------------
            elif hasattr(value, "labels"):
                node_id = str(value.element_id)
                nodes[node_id] = {
                    "data": {
                        "id": node_id,
                        "label": list(value.labels)[0],
                        **dict(value)
                    }
                }

            # -----------------------
            # If data is a RELATIONSHIP
            # -----------------------
            elif hasattr(value, "type"):
                edges.append({
                    "data": {
                        "source": str(value.start_node.element_id),
                        "target": str(value.end_node.element_id),
                        "label": value.type
                    }
                })

    # Deduplicate nodes
    node_list = list(nodes.values())

    return node_list + edges, None


# ----------------------------------------------------------
# 6.2 — MASTER GRAPH EXECUTION HELPER
# ----------------------------------------------------------
def generate_enterprise_graph(graph_type):
    """
    1. Looks up Cypher query from GRAPH_QUERY_MAP  
    2. Executes it  
    3. Converts to Cytoscape  
    """

    if graph_type not in GRAPH_QUERY_MAP:
        return [], f"❗ Graph type not found: {graph_type}"

    cypher = GRAPH_QUERY_MAP[graph_type]

    # Run query
    records, err = run_neo4j_graph_query(cypher)
    if err:
        return [], err

    # Convert to Cytoscape elements
    elements, err = neo4j_to_cytoscape(records)
    if err:
        return [], err

    return elements, f"✅ Graph ready: {graph_type}"


