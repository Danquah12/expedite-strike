import re
import base64
import subprocess


# ----------------------------------------------------------
# 3.1 — Extract IPs/Subnets From Uploaded File
# ----------------------------------------------------------
def extract_ips_from_text(text):
    """
    Accepts file content as text.
    Returns list of IPv4 addresses + CIDR ranges.
    """
    pattern = r"\b(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?\b"
    matches = re.findall(pattern, text)
    return list(set(matches))  # unique only


# ----------------------------------------------------------
# 3.2 — Process Uploaded File (Dash Callback helper)
# ----------------------------------------------------------
def process_uploaded_file(contents):
    """
    Decode uploaded file content from Dash Upload component.
    Returns extracted targets.
    """
    if not contents:
        return []

    try:
        header, encoded = contents.split(",", 1)
        raw_bytes = base64.b64decode(encoded)
        text = raw_bytes.decode("utf-8", errors="ignore")

        ip_list = extract_ips_from_text(text)
        print(f"📥 Uploaded file extracted {len(ip_list)} targets.")
        return ip_list

    except Exception as e:
        print(f"❌ Upload decode error: {e}")
        return []


# ----------------------------------------------------------
# 3.3 — Normalize Target Inputs (Manual or Upload)
# ----------------------------------------------------------
def normalize_targets(raw_text):
    """
    Accepts: "192.168.1.1, 10.0.0.0/24 172.16.5.10"
    Returns: ["192.168.1.1", "10.0.0.0/24", "172.16.5.10"]
    """
    if not raw_text:
        return []

    raw_text = raw_text.replace(",", " ")
    tokens = [t.strip() for t in raw_text.split() if t.strip()]

    # validate using regex
    valid = []
    for t in tokens:
        if re.match(r"^(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?$", t):
            valid.append(t)

    return list(set(valid))  # unique only


# ----------------------------------------------------------
# 3.4 — Run Nmap Scan (Live Output Streaming)
# ----------------------------------------------------------
def run_nmap_scan(targets):
    """
    Executes an Nmap scan with XML output.
    Streams terminal output LIVE.
    Returns:
        - XML output file path
        - full verbose terminal text (for dashboard)
    """

    os.makedirs(f"{PROJECT_ROOT}/scans", exist_ok=True)
    xml_output = f"{PROJECT_ROOT}/scans/nmap_scan_{int(time.time())}.xml"

    cmd = [
        "nmap",
        "-sV",
        "-O",
        "-T4",
        "-v",
        "-oX", xml_output
    ] + targets

    print(f"▶️ Running Nmap: {' '.join(cmd)}")

    verbose_log = ""

    try:
        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True
        )

        # Read output line-by-line
        for line in process.stdout:
            print(line, end="")
            verbose_log += line

        process.wait()

        if process.returncode != 0:
            print("❌ Nmap returned an error.")

    except Exception as e:
        print(f"❌ Nmap execution failed: {e}")
        return None, ""

    print(f"📝 XML saved: {xml_output}")
    return xml_output, verbose_log


# ----------------------------------------------------------
# 3.5 — FULL SCAN PIPELINE (Nmap → XML Parse → DB Save → Neo4j)
# ----------------------------------------------------------
def full_scan_pipeline(targets, trigger_neo4j=True):
    """
    Given a target list:
        1. Run Nmap scan
        2. Parse XML
        3. Save to SQLite
        4. Optional: Import into Neo4j
    Returns dashboard-formatted status message.
    """

    if not targets:
        return "⚠️ No valid targets provided."

    # --- Step 1: Execute Nmap ---
    xml_path, verbose = run_nmap_scan(targets)
    if not xml_path:
        return "❌ Nmap scan failed."

    # --- Step 2: Parse XML ---
    parsed = parse_nmap_xml(xml_path)
    if not parsed:
        return "⚠️ XML parsed but no services found."

    # --- Step 3: Save results to SQLite ---
    save_scan_to_database(parsed)

    # --- Step 4: Import to Neo4j (Optional) ---
    if trigger_neo4j:
        try:
            import_nmap_hosts_to_neo4j(parsed)
            print("📡 Neo4j import complete.")
        except Exception as e:
            print(f"Neo4j Import Error: {e}")

    return (
        f"✅ Scan Complete\n"
        f"Targets: {', '.join(targets)}\n"
        f"Services parsed: {len(parsed)}\n"
        f"XML File: {xml_path}\n\n"
