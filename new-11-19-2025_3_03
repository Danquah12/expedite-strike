        "selector": "node:hover",
        "style": {
            "border-width": 3,
            "border-color": "#FFD700",
            "cursor": "pointer"
        }
    },

    # Selected highlight
    {
        "selector": "node:selected",
        "style": {
            "border-width": 4,
            "border-color": "#ffdd33",
            "background-color": "#ffcc00",
            "color": "#000",
            "font-weight": "bold"
        }
    }
]


# ==========================================================
#  PART 11 — INTERACTIVE GRAPH CLICK EVENTS
#  (Node Details Panel + Towson Branded Output)
# ==========================================================


@app.callback(
    Output("neo4j-graph-details", "children"),
    Input("neo4j-graph-view", "tapNode")
)
def show_graph_node_details(node):

    if not node:
        return html.Div(
            "👆 Click a node to view its details.",
            style={"color": "#EAAA00", "padding": "10px"}
        )

    data = node.get("data", {})
    label = data.get("label", "Node")

    # ======================================================
    # ASSET DETAILS
    # ======================================================
    if label == "Asset":
        return html.Div([
            html.H4("🖥️ Asset Details", style={"color": "#EAAA00"}),
            html.P(f"IP Address: {data.get('host', 'N/A')}", style={"color": "white"}),
            html.P(f"Hostname: {data.get('hostname', 'N/A')}", style={"color": "white"}),
            html.P(f"Operating System: {data.get('os', 'N/A')}", style={"color": "white"}),
            html.P(f"Services Running: {data.get('service_count', 'N/A')}", style={"color": "#bbb"}),
        ], style={"padding": "10px"})

    # ======================================================
    # SERVICE DETAILS
    # ======================================================
    if label == "Service":
        return html.Div([
            html.H4("🔌 Service Details", style={"color": "#EAAA00"}),
            html.P(f"Service Name: {data.get('name', 'N/A')}", style={"color": "white"}),
            html.P(f"Port: {data.get('port', 'N/A')}", style={"color": "white"}),
            html.P(f"Protocol: {data.get('protocol', 'N/A')}", style={"color": "white"}),
            html.P(f"Product: {data.get('product', 'N/A')}", style={"color": "white"}),
            html.P(f"Version: {data.get('version', 'N/A')}", style={"color": "white"}),
        ], style={"padding": "10px"})

    # ======================================================
    # VULNERABILITY DETAILS
    # ======================================================
    if label == "Vulnerability":
        cve = data.get("id", "N/A")
        cvss = data.get("cvss", "N/A")
        cwe = data.get("cwe", "N/A")
        cpe = data.get("cpe", "N/A")
        desc = data.get("description", "No description available")

        nvd_url = f"https://nvd.nist.gov/vuln/detail/{cve}" if cve.startswith("CVE") else None

        return html.Div([
            html.H4("🚨 Vulnerability Details", style={"color": "#EAAA00"}),

            html.P(f"CVE: {cve}", style={"color": "white"}),

            html.P(
                html.A("View on NVD", href=nvd_url, target="_blank"),
                style={"color": "#EAAA00"}
            ) if nvd_url else None,

            html.P(f"CVSS Score: {cvss}", style={"color": "white"}),
            html.P(f"CWE: {cwe}", style={"color": "white"}),
            html.P(f"CPE: {cpe}", style={"color": "#bbb"}),
            html.Hr(),
            html.P(f"Description:", style={"color": "#EAAA00"}),
            html.P(desc, style={"color": "white"}),
        ], style={"padding": "10px"})

    # ======================================================
    # FALLBACK GENERIC NODE DETAILS
    # ======================================================
    return html.Div([
        html.H4(f"📍 {label} Details", style={"color": "#EAAA00"}),
        html.Pre(str(data), style={"color": "white", "whiteSpace": "pre-wrap"})
    ])



