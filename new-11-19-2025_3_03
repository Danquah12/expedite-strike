@app.callback(
    Output("neo4j-graph-details", "children"),
    Input("neo4j-graph-view", "elements"),
    prevent_initial_call=True
)
def update_graph_details(elements):

    if not elements:
        return html.Div(
            "⚠️ No graph data available.",
            style={"color": "#ff6666", "fontWeight": "bold"}
        )

    # ------------------------------
    # Separate nodes vs edges
    # ------------------------------
    nodes = [el for el in elements if "source" not in el["data"]]
    edges = [el for el in elements if "source" in el["data"]]

    node_count = len(nodes)
    edge_count = len(edges)

    # ------------------------------
    # Count node types (Asset, Service, Vulnerability)
    # ------------------------------
    type_counts = {}
    for n in nodes:
        label = n["data"].get("label", "Unknown")
        type_counts[label] = type_counts.get(label, 0) + 1

    # ------------------------------
    # Severity statistics (Critical, High, Medium, Low)
    # ------------------------------
    severity_count = {"Critical": 0, "High": 0, "Medium": 0, "Low": 0}

    for n in nodes:
        label = n["data"].get("label", "")
        if label == "Vulnerability":
            cve_id = n["data"].get("id", "")
            if "Critical" in cve_id:
                severity_count["Critical"] += 1
            elif "High" in cve_id:
                severity_count["High"] += 1
            elif "Medium" in cve_id:
                severity_count["Medium"] += 1
            else:
                severity_count["Low"] += 1

    # ------------------------------
    # Auto Legend for colors
    # ------------------------------
    legend = html.Div([
        html.H5("Graph Legend", style={"color":"#EAAA00"}),

        html.Div("🟩 Asset Nodes", style={"color": "#28a745"}),
        html.Div("🟦 Service Nodes", style={"color": "#007bff"}),
        html.Div("🟥 Vulnerability Nodes", style={"color": "#dc3545"}),
        html.Br(),
    ])

    # ------------------------------
    # Assemble Info Panel
    # ------------------------------
    return html.Div([

        html.H4("📊 Graph Summary", style={"color": "#EAAA00"}),

        html.P(f"🧩 Total Nodes: {node_count}"),
        html.P(f"🔗 Total Edges: {edge_count}"),

        html.H5("📚 Node Types:", style={"marginTop": "10px"}),
        html.Ul([html.Li(f"{t}: {c}") for t, c in type_counts.items()]),

        html.H5("🔥 Vulnerability Severity:", style={"marginTop": "15px"}),
        html.Ul([
            html.Li(f"Critical: {severity_count['Critical']}"),
            html.Li(f"High: {severity_count['High']}"),
            html.Li(f"Medium: {severity_count['Medium']}"),
            html.Li(f"Low: {severity_count['Low']}"),
