# ----------------------------------------------------------
# 9.4 — Performance-Optimized Graph Builder
# ----------------------------------------------------------
def generate_fast_graph(graph_type):
    """
    Upgraded version of generate_enterprise_graph:
    - Adds timeout
    - Adds safe query runner
    - Adds compression
    - Adds dynamic relayout
    """

    if graph_type not in GRAPH_QUERY_MAP:
        return [], "⚠️ Unknown graph type."

    cypher = GRAPH_QUERY_MAP[graph_type]

    # Connect
    driver = GraphDatabase.driver(
        "bolt://localhost:7687",
        auth=("neo4j", "Adomaa12@")
    )

    # Run safely
    records, err = safe_neo4j_run(driver, cypher)
    if err:
        return [], err

    # Convert to Cytoscape
    elements, conv_err = neo4j_to_cytoscape(records)
    if conv_err:
        return [], conv_err

    # Count nodes
    node_count = len([e for e in elements if "source" not in e["data"]])

    # Compress if too large
    if node_count > MAX_GRAPH_NODES:
        nodes = [e for e in elements if "source" not in e["data"]]
        edges = [e for e in elements if "source" in e["data"]]

        nodes, edges, msg = compress_large_graph(nodes, edges)
        final_elements = nodes + edges

        return final_elements, msg

    return elements, f"✅ Graph loaded ({node_count} nodes)"


