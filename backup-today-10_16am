# -------- Callback 2: Start Scan & Reconcile With Existing Nmap Feeds --------
@app.callback(
    Output("upload-scan-status", "children"),
    Input("button-start-scan", "n_clicks"),
    State("uploaded-ip-preview", "children"),
    prevent_initial_call=True
)
def start_uploaded_scan(n_clicks, preview):

    if n_clicks == 0:
        return dash.no_update

    if preview is None or "Detected" not in preview:
        return "❌ Cannot start scan — no valid uploaded targets."

    # Parse targets from preview box
    raw_lines = preview.split("\n")
    ips = [line.strip()
           for line in raw_lines
           if re.match(r"(?:\d{1,3}\.){3}\d{1,3}", line)]

    if not ips:
        return "❌ No valid IP addresses to scan."

    # =============================
    # Save targets to Nmap file
    # =============================
    target_dir = "/root/vuln_intel/feeds/nmap"
    Path(target_dir).mkdir(parents=True, exist_ok=True)

    target_file = f"{target_dir}/upload_targets.txt"
    Path(target_file).write_text("\n".join(ips))

    # Output XML file (consistent with existing naming convention)
    output_file = f"{target_dir}/scan_uploaded.xml"

    # =============================
    # Run the Nmap scan (same flags as your main pipeline)
    # =============================
    cmd = f"nmap -sV -T4 -iL {target_file} -oX {output_file}"
    os.system(cmd)

    # =============================
    # Merge & Import into SQLite + Neo4j
    # =============================
    import_script = "/root/vuln_intel/app/import_scans.py"
    os.system(f"python3 {import_script}")

    # =============================
    # Return user-friendly status
    # =============================
    return (
        f"✅ Scan completed for {len(ips)} target(s).\n"
        f"📁 **Results saved:** {output_file}\n"
        f"🗄 **Merged into database (vuln_intel.db)** via import_scans.py\n"
        f"🌐 **Neo4j graph updated**\n"
        f"📊 Dashboard auto-refresh will display new vulnerabilities."
    )




