# -------- Helper: Extract IPs/Subnets --------
def extract_ips(text):
    """
    Extract IPv4 addresses and CIDR ranges from uploaded files.
    Supports examples:
    192.168.1.1
    192.168.1.0/24
    10.0.0.0/16
    """
    pattern = r"\b(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?\b"
    return re.findall(pattern, text)


