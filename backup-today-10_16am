@app.callback(
    Output("scan-status", "children"),
    Input("scan-btn", "n_clicks"),
    State("scanner-select", "value"),
    State("target-ip", "value"),
    prevent_initial_call=True,
)
def trigger_scan(n, scanner, target):
    import subprocess, os, time

    if not scanner or not target:
        return "⚠️ Please select a scanner and provide target(s)."

    # Normalize IP list (handles commas, spaces, mixed)
    normalized = target.replace(",", " ")
    targets = [t.strip() for t in normalized.split() if t.strip()]

    if not targets:
        return "⚠️ Invalid target format."

    # ---------------------- NMAP ----------------------
    if scanner == "nmap":

        # Ensure scan directory exists
        os.makedirs("/root/vuln_intel/scans", exist_ok=True)

        # Unique XML output filename
        xml_output = f"/root/vuln_intel/scans/nmap_scan_{int(time.time())}.xml"

        # Build the Nmap command with XML output enabled
        cmd = [
            "nmap",
            "-sV",
            "-O",
            "-v",
            "-oX", xml_output,
        ] + targets

        try:
            # ------------------------------------------------------
            # 1. STREAM OUTPUT TO TERMINAL LIVE
            # ------------------------------------------------------
            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )

            verbose_log = ""   # store verbose output for dashboard

            for line in process.stdout:
                print(line, end="")      # live output to Kali terminal
                verbose_log += line      # append to dashboard log

            process.wait()

            # ------------------------------------------------------
            # 2. PARSE XML + SAVE TO SQLITE DATABASE
            # ------------------------------------------------------
            scan_results = parse_nmap_xml(xml_output)
            save_scan_to_database(scan_results)

            # ------------------------------------------------------
            # 3. RETURN FORMATTED RESULTS TO DASHBOARD
            # ------------------------------------------------------
            return html.Pre(
                f"✅ Nmap Scan Complete!\n"
                f"🖥️ Targets: {', '.join(targets)}\n"
                f"📄 XML Saved: {xml_output}\n"
                f"🔍 Parsed Services: {len(scan_results)}\n\n"
                "------------------ NMAP VERBOSE OUTPUT ------------------\n"
                f"{verbose_log}",
                style={"color": "#EAAA00", "whiteSpace": "pre-wrap"},
            )

        except Exception as e:
            return f"❌ Error running Nmap: {str(e)}"

    # ---------------------- OTHER SCANNERS ----------------------
    return f"Triggered {scanner} scan for: {targets}"


