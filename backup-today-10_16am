#  CALLBACK: LOAD NEO4J GRAPH DATA BASED ON SELECTION
# ==========================================================
@app.callback(
    [Output("neo4j-graph", "elements",allow_duplicate=True),
    Output("graph-title", "children",allow_duplicate = True)],

    Input("graph-type", "value"),
    prevent_initial_call=True
)
def load_selected_graph(graph_type):
    """
    Load Neo4j graph data for selected visualization type.
    """
    if not graph_type:
        return no_update, ""

    from neo4j import GraphDatabase
    driver = GraphDatabase.driver("bolt://localhost:7687", auth=("neo4j", "Adomaa12@"))
    elements = []
    title = ""

    try:
        with driver.session() as session:
            if graph_type == "attack_path":
                title = "🔥 Attack Path Graph"
                query = """
                MATCH p=(a:Asset)-[:RUNS_SERVICE|:HAS_VULNERABILITY*1..3]->(v:Vulnerability)
                RETURN p LIMIT 50
                """
            elif graph_type == "asset_service":
                title = "🖥️ Asset-Service Map"
                query = """
                MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
                RETURN a,s
                """
            elif graph_type == "vuln_link":
                title = "🕸️ Vulnerability Link Graph"
                query = """
                MATCH (s:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
                RETURN s,v
                """
            elif graph_type == "service_dep":
                title = "⚙️ Service Dependency Graph"
                query = """
                MATCH (s1:Service)-[:DEPENDS_ON]->(s2:Service)
                RETURN s1,s2
                """
            elif graph_type == "cvss_distribution":
                title = "📊 CVSS Severity Distribution Graph"
                query = """
                MATCH (v:Vulnerability)
                RETURN v
                """
            elif graph_type == "cve_chain":
                title = "🔗 CVE Propagation Chain"
                query = """
                MATCH p=(v1:Vulnerability)-[:RELATED_TO*1..3]->(v2:Vulnerability)
                RETURN p LIMIT 50
                """
            else:
                return [], f"⚠️ Unknown graph type: {graph_type}"

            # Run Neo4j query and format data for Cytoscape
            records = session.run(query)
            for record in records:
                for key, node in record.items():
                    if hasattr(node, "id") and hasattr(node, "labels"):
                        label = list(node.labels)[0]
                        node_id = str(node.id)
                        elements.append({
                            "data": {"id": node_id, "label": node.get("host") or node.get("name") or node.get("id") or label, "type": label}
                        })

            # Add edges if the query returned paths
            for record in records:
                if "p" in record:
                    for rel in record["p"].relationships:
                        elements.append({
                            "data": {
                                "source": str(rel.start_node.id),
                                "target": str(rel.end_node.id)
                            }
                        })

    except Exception as e:
        print(f"[!] Error loading {graph_type} graph: {e}")
        title = f"⚠️ Error loading {graph_type} graph"
    finally:
        driver.close()

    return elements, title


# ==========================================================
#  CALLBACK: Build Graph Elements from Neo4j
# ==========================================================
@app.callback(
    [Output("neo4j-graph", "elements"),
     Output("graph-info", "children")],
    Input("graph-type", "value")
)
def load_selected_graph(graph_type):
    from neo4j_integration import get_driver
    driver = get_driver()
    elements = []
    message = "⚠️ No records found."
    q = ""

    try:
        # ------------------- CORE GRAPHS -------------------
        if graph_type == "attack_path":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, s.name AS service, v.id AS vuln, v.cvss AS cvss
            """
            message = "🔺 Attack Path Graph"

        elif graph_type == "service_vuln":
            q = """
            MATCH (s:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN s.name AS service, v.id AS vuln, v.cvss AS cvss
            """
            message = "🔹 Service–Vulnerability Graph"

        elif graph_type == "asset_dep":
            q = """
            MATCH (a1:Asset)-[:RUNS_SERVICE]->(s:Service)<-[:RUNS_SERVICE]-(a2:Asset)
            RETURN a1.host AS asset1, s.name AS service, a2.host AS asset2
            """
            message = "🧩 Asset Dependency Graph"

        elif graph_type == "network_topo":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            RETURN a.host AS asset, s.name AS service
            """
            message = "🌐 Network Topology Graph"

        elif graph_type == "cvss_heat":
            q = """
            MATCH (v:Vulnerability)
            RETURN v.id AS vuln, v.cvss AS cvss
            """
            message = "🔥 CVSS Risk Heat Graph"

        # ------------------- RUN QUERY -------------------
        with driver.session() as session:
            records = list(session.run(q))
            for r in records:
                record = dict(r)
                for key, val in record.items():
                    if val is None:
                        continue
                    if "asset" in key:
                        elements.append({'data': {'id': val, 'label': 'Asset'}})
                    elif "service" in key:
                        elements.append({'data': {'id': val, 'label': 'Service'}})
                    elif "vuln" in key:
                        color = "#dc3545"
                        if record.get("cvss"):
                            score = float(record["cvss"])
                            if score >= 9: color = "#ff073a"
                            elif score >= 7: color = "#ff8800"
                            elif score >= 4: color = "#ffc107"
                            else: color = "#28a745"
                        elements.append({'data': {'id': val, 'label': 'Vulnerability'}, 'classes': color})

                # Create edges
                fields = list(record.values())
                if len(fields) >= 2:
                    elements.append({'data': {'source': str(fields[0]), 'target': str(fields[1])}})

        driver.close()
        return elements, f"{message} — {len(elements)} elements."

    except Exception as e:
        driver.close()
        return [], f"❌ Error loading {graph_type}: {e}"


