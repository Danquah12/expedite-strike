def update_vuln_dashboard(_, refresh_clicks):
    from neo4j import GraphDatabase
    import plotly.express as px
    import pandas as pd
    from datetime import datetime
    from neo4j_integration import enrich_cves_from_nvd

    print("[+] Updating Vulnerability Dashboard...")

    uri = "bolt://localhost:7687"
    user = "neo4j"
    password = "Adomaa12@"

    assets, services, vulns = set(), set(), set()
    nodes, edges, table_data, heatmap_data = [], [], [], []
    new_critical_high = []

    try:
        driver = GraphDatabase.driver(uri, auth=(user, password))
        with driver.session() as session:

            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, s.name AS service, s.port AS port,
                   v.id AS vuln, v.cvss AS cvss
            """

            data = list(session.run(q))

            # ----------------------------- CVSS Enrichment -----------------------------
            missing = [rec["vuln"] for rec in data if rec["vuln"] and rec["cvss"] is None]
            if missing:
                print(f"[!] Enriching {len(missing)} missing CVSS scores...")
                enrich_cves_from_nvd(limit=50)
                data = list(session.run(q))

            # ----------------------------- PROCESS RESULTS -----------------------------
            for rec in data:
                a, s, p, v, cvss = (
                    rec["asset"], rec["service"], rec["port"], rec["vuln"], rec["cvss"]
                )

                if a: assets.add(a)
                if s: services.add(s)
                if v: vulns.add(v)

                # Asset node
                if a:
                    nodes.append({"data": {"id": a, "label": "Asset"}})

                # Service node
                if s:
                    sid = f"{s}:{p}"
                    nodes.append({"data": {"id": sid, "label": "Service"}})
                    edges.append({"data": {"source": a, "target": sid}})

                # Vulnerability node
                if v:
                    nodes.append({"data": {"id": v, "label": "Vulnerability"}})
                    edges.append({"data": {"source": sid, "target": v}})

                # CVE hyperlink
                if v and v.startswith("CVE-"):
                    nvd_link = f"[{v}](https://nvd.nist.gov/vuln/detail/{v})"
                else:
                    nvd_link = v or "None"

                # Severity Label
                if cvss is None:
                    severity = "Informational"
                elif cvss >= 9.0:
                    severity = "Critical"
                elif cvss >= 7.0:
                    severity = "High"
                elif cvss >= 4.0:
                    severity = "Medium"
                else:
                    severity = "Low"

                severity_label = f"{nvd_link} ({severity})"

                # Table row
                table_data.append({
                    "Asset": a or "",
                    "Service": s or "",
                    "Port": p or "",
                    "Vulnerability": severity_label
                })

                # Alerts
                if cvss and cvss >= 7.0:
                    new_critical_high.append(v)

                # Heatmap
                if v and cvss is not None:
                    heatmap_data.append({"Vulnerability": v, "CVSS": float(cvss)})

        driver.close()

    except Exception as e:
        print(f"[!] Neo4j error: {e}")
        empty_fig = px.scatter(title="⚠️ Error loading data")
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    # ----------------------------- Vulnerabilities Per Asset -----------------------------
    if table_data:
        df_table = pd.DataFrame(table_data)
        vulns_asset_fig = px.bar(
            df_table,
            x="Asset",
            title="Vulnerabilities Per Asset",
            labels={"Asset": "Asset", "count": "Vulnerability Count"},
        )
        vulns_asset_fig.update_layout(
            plot_bgcolor="#111", paper_bgcolor="#111", font_color="#fff"
        )
    else:
        vulns_asset_fig = px.bar(title="No data available")

    # ----------------------------- Top CVEs -----------------------------
    if table_data:
        df_table = pd.DataFrame(table_data)
        df_table["CVE"] = df_table["Vulnerability"].str.extract(r'(CVE-\d+-\d+)')

        top = (
            df_table["CVE"]
            .value_counts()
            .rename_axis("CVE")
            .reset_index(name="Count")
            .head(10)
        )

        top_vulns_fig = px.bar(
            top,
            x="CVE",
            y="Count",
            title="Top 10 Most Frequent CVEs",
        )
        top_vulns_fig.update_layout(
            plot_bgcolor="#111", paper_bgcolor="#111", font_color="#fff"
        )
    else:
        top_vulns_fig = px.bar(title="No CVE data available")

        
        return (
            "0", "0", "0", [], [], empty_fig,
            None,
            html.Div("⚠️ Error connecting to Neo4j", style={"color": "red"}),
            f"Last updated: {timestamp}"
        )

    # ----------------------------- Deduplicate Nodes -----------------------------
    unique_nodes = {}
    for n in nodes:
        unique_nodes[n["data"]["id"]] = n
    elements = list(unique_nodes.values()) + edges

    # ----------------------------- Heatmap -----------------------------
    if heatmap_data:
        df = pd.DataFrame(heatmap_data)
        fig = px.density_heatmap(
            df, x="Vulnerability", y="CVSS",
            color_continuous_scale="RdYlGn_r",
            title="CVSS Severity Distribution"
        )
        fig.update_layout(
            plot_bgcolor="#111",
            paper_bgcolor="#111",
            font_color="#fff"
        )
    else:
        fig = px.scatter(title="No CVSS data available")

    # ----------------------------- Alerts -----------------------------
    if new_critical_high:
        audio_src = "/assets/alert.mp3"
        alert_banner = html.Div(
            f"🚨 {len(new_critical_high)} High/Critical vulnerabilities detected!",
            style={
                "backgroundColor": "#ff073a",
                "padding": "12px",
                "color": "white",
                "textAlign": "center",
                "fontWeight": "bold"
            }
        )
    else:
        audio_src = None
        alert_banner = ""

    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[+] Dashboard updated: {len(assets)} assets, {len(services)} services, {len(vulns)} vulnerabilities.")

    return (
        str(len(assets)),
        str(len(services)),
        str(len(vulns)),
        elements,
        table_data,
        fig,
        vulns_asset_fig,
        top_vulns_fig,
        audio_src,
        alert_banner,
        f"Last updated: {timestamp}"
    )


