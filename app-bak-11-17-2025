print(f"[+] Loading vulnerability data from: {DB_PATH}")

def load_findings():
    """Safely pull all findings from the SQLite DB into a DataFrame."""
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql_query("""
            SELECT
                id,
                COALESCE(asset_id, '') AS asset_id,
                COALESCE(host, '') AS host,
                COALESCE(port, '') AS port,
                COALESCE(service, '') AS service,
                COALESCE(title, '') AS title,
                COALESCE(severity, '') AS severity,
                COALESCE(cvss, '') AS cvss,
                COALESCE(cve_id, '') AS cve_id,
                COALESCE(description, '') AS description,
                COALESCE(evidence, '') AS evidence,
                COALESCE(remediation, '') AS remediation,
                COALESCE(vuln_name, '') AS vuln_name,
                COALESCE(path, '') AS path,
                COALESCE(source, '') AS source,
                COALESCE(import_date, '') AS import_date,
                COALESCE(timestamp, '') AS timestamp
            FROM findings
            ORDER BY import_date DESC, id DESC
        """, conn)
        conn.close()
        print(f"✅ Loaded {len(df)} findings into dashboard.")
        return df
    except Exception as e:
        print(f"❌ Error reading DB: {e}")
        return pd.DataFrame()

# Initial load
