# ==========================================================
# 8️⃣ Data Utilities: Load findings.db and filters
# ==========================================================
import pandas as pd
import io
import base64
import requests

DB_PATH = f"{PROJECT_ROOT}/app/data/findings.db"

def load_findings():
    """Read vulnerability data from SQLite."""
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql_query("SELECT * FROM findings", conn)
        conn.close()
        return df
    except Exception as e:
        append_status(f"[ERROR] Could not read findings.db: {e}")
        return pd.DataFrame()

# ==========================================================
# 9️⃣ CSV Import/Export Utilities
# ==========================================================
def export_findings_to_csv():
    df = load_findings()
    if df.empty:
        return "No data available to export."
    path = f"{PROJECT_ROOT}/app/exported_findings.csv"
    df.to_csv(path, index=False)
    append_status(f"Exported {len(df)} rows to {path}")
    return f"✅ Exported {len(df)} rows to exported_findings.csv"

def import_csv_to_findings(file_contents):
    """Decode and append uploaded CSV content into findings.db."""
    content_type, content_string = file_contents.split(',')
    decoded = base64.b64decode(content_string)
    df_new = pd.read_csv(io.StringIO(decoded.decode('utf-8')))

    conn = sqlite3.connect(DB_PATH)
    df_existing = pd.read_sql_query("SELECT * FROM findings", conn)
    combined = pd.concat([df_existing, df_new]).drop_duplicates(subset=['id'], keep='last')
    combined.to_sql('findings', conn, if_exists='replace', index=False)
    conn.close()
    append_status(f"Imported {len(df_new)} rows into findings.db")
    return f"✅ Imported {len(df_new)} new findings."

