@app.callback(
    Output("neo4j-sync-status", "children"),
    Input("neo4j-sync-btn", "n_clicks"),
    prevent_initial_call=True
)
def sync_to_neo4j(n):
    msg = push_findings_to_neo4j()
    return msg


@app.callback(
    Output("graph-summary-plot", "figure"),
    Input("neo4j-sync-btn", "n_clicks"),
    prevent_initial_call=True
)
def update_graph_summary(_):
    df = get_graph_summary()
    if df.empty:
        return px.bar(title="No Neo4j Data Found")

    fig = px.bar(
        df,
        x="host", y="vulns",
        title="Top Vulnerable Assets (Neo4j Data)",
        labels={"vulns": "Vulnerability Count", "host": "Host"},
        color="vulns",
        color_continuous_scale="Oranges"
    )
    fig.update_layout(
        paper_bgcolor="#111", plot_bgcolor="#111",
        font_color="#EAAA00", height=400
    )
    return fig

 

# ==========================================================
#  VOICE ASSISTANT TAB — Speech to Text + OpenAI Integration
# ==========================================================

import speech_recognition as sr
import pyttsx3

def speak_text(text: str):
    """Convert text to spoken audio locally (TTS)."""
    try:
        engine = pyttsx3.init()
        engine.setProperty("rate", 160)
        engine.setProperty("volume", 1.0)
        engine.say(text)
        engine.runAndWait()
    except Exception as e:
        append_status(f"TTS error: {e}")

def listen_to_voice():
    """Capture speech input from microphone and transcribe."""
    recognizer = sr.Recognizer()
    mic = sr.Microphone()
    with mic as source:
        append_status("Listening for voice input...")
        recognizer.adjust_for_ambient_noise(source)
        audio = recognizer.listen(source)
    try:
        text = recognizer.recognize_google(audio)
        append_status(f"Recognized: {text}")
        return text
    except sr.UnknownValueError:
        return "Sorry, I could not understand the audio."
    except sr.RequestError as e:
        return f"Speech recognition error: {e}"

voice_tab = html.Div([
    html.H3("🎙️ Voice Assistant", className="text-warning"),
    html.P("Speak your command to interact with the dashboard (e.g., 'Summarize high CVEs').", style={"color": "#AAA"}),

    dbc.Button("🎧 Start Listening", id="voice-btn", color="warning", className="mb-3"),
    html.Div(id="voice-status", style={"color": "#EAAA00", "marginBottom": "10px"}),

    html.H5("Recognized Text", style={"color": "#EAAA00"}),
    html.Div(id="recognized-text", style={"color": "#FFF", "whiteSpace": "pre-wrap"}),

    html.H5("Assistant Reply", style={"color": "#EAAA00"}),
    html.Div(id="voice-reply", style={"color": "#FFF", "whiteSpace": "pre-wrap"}),

    dbc.Checklist(
        id="voice-options",
        options=[{"label": "Speak Reply", "value": "tts"}],
        value=[],
        inline=True,
        style={"marginTop": "10px", "color": "#FFF"}
    ),
])

@app.callback(
    [Output("voice-status", "children"),
     Output("recognized-text", "children"),
     Output("voice-reply", "children")],
    [Input("voice-btn", "n_clicks")],
    [State("voice-options", "value")],
    prevent_initial_call=True
)
def handle_voice_command(n, options):
    status = "🎤 Listening..."
    text = listen_to_voice()
    if not text:
        return "❌ No audio captured.", "", ""
    reply = call_llm(text)
    if "tts" in options:
        speak_text(reply)
    return f"✅ You said: {text}", text, reply

