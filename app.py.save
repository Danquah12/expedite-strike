@app.callback(
    Output("report-output", "children"),
    Output("report-list", "children"),
    Input("report-btn", "n_clicks"),
    prevent_initial_call=True
)
def generate_and_list_reports(n):
    path = generate_pdf_report()
    if not path:
        return "⚠️ No data available to report.", []
    reports = sorted(REPORT_DIR.glob("*.pdf"), key=os.path.getmtime, reverse=True)
    links = [
        html.Li(html.A(r.name, href=f"/download_report?file={r.name}", target="_blank"))
        for r in reports
    ]
    return f"✅ Report generated: {os.path.basename(path)}", links


# ----------------------------
# Flask Download Route
# ----------------------------
@app.server.route("/download_report")
def download_report():
    from flask import send_from_directory, request
    fname = request.args.get("file")
    if not fname:
        return "Missing file param", 400
    return send_from_directory(REPORT_DIR, fname, as_attachment=True)




