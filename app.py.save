# ==========================================================
#  CHATBOT TAB — Interactive Vulnerability Assistant
# ==========================================================

def query_findings_for_context(query_text: str) -> str:
    """Lightweight retrieval: pull relevant rows from findings.db."""
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql_query(
            "SELECT host, port, service, severity, cve_id, description "
            "FROM findings WHERE severity IS NOT NULL AND cve_id IS NOT NULL", conn)
        conn.close()
        if df.empty:
            return "No vulnerability data available in database."

        # basic filter by keywords (host/IP or severity)
        q = query_text.lower()
        mask = df.apply(lambda r: any(qword in str(r).lower() for qword in q.split()), axis=1)
        subset = df[mask].head(10)
        if subset.empty:
            subset = df.sample(min(5, len(df)))  # fallback sample
        return subset.to_string(index=False)
    except Exception as e:
        return f"DB query failed: {e}"


def chatbot_llm(prompt: str) -> str:
    """Send prompt + contextual findings to OpenAI for reasoning."""
    if not OPENAI_API_KEY:
        return "⚠️ OpenAI key missing."

    try:
        context = query_findings_for_context(prompt)
        headers = {
            "Authorization": f"Bearer {OPENAI_API_KEY}",
            "Content-Type": "application/json"
        }
        data = {
            "model": OPENAI_MODEL,
            "messages": [
                {"role": "system", "content": (
                    "You are a cybersecurity analyst.  "
                    "Use the vulnerability data below to answer user questions clearly and concisely."
                )},
                {"role": "user", "content": f"User question: {prompt}\n\nVulnerability data:\n{context}"}
            ],
            "temperature": 0.4
        }
        r = requests.post("https://api.openai.com/v1/chat/completions",
                          headers=headers, json=data, timeout=25)
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"]
    except Exception as e:
        return f"Chatbot error: {e}"


