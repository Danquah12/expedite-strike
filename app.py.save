# ==========================================================
#  ASSESSMENT TAB — Automated Scanning + Import/Export
# ==========================================================

LAB_WHITELIST = ["192.168.", "10.", "172.16."]  # adjust if needed

UPLOAD_DIR = Path("/root/vuln_intel/app/data/uploads")
UPLOAD_DIR.mkdir(parents=True, exist_ok=True)


def allowed_target(ip: str) -> bool:
    """Restrict scans to lab/private ranges."""
    return any(ip.startswith(prefix) for prefix in LAB_WHITELIST)


def run_nmap_scan(targets: list[str]) -> str:
    """Run Nmap verbose scan; save XML; return path."""
    xml_path = UPLOAD_DIR / f"nmap_scan_{int(time.time())}.xml"
    cmd = ["nmap", "-sV", "-T4", "-v", "-oX", str(xml_path)] + targets
    append_status(f"Starting Nmap scan on: {', '.join(targets)}")
    subprocess.run(cmd, capture_output=True, text=True)
    append_status(f"Nmap scan completed → {xml_path}")
    return str(xml_path)


def parse_and_ingest(xml_file: str):
    """Parse Nmap XML and insert findings into SQLite."""
    try:
        from xml.etree import ElementTree as ET
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        tree = ET.parse(xml_file)
        root = tree.getroot()
        for host in root.findall("host"):
            addr = host.find("address").attrib.get("addr", "unknown")
            for port in host.findall(".//port"):
                portid = port.attrib.get("portid")
                service = port.find("service")
                name = service.attrib.get("name") if service is not None else None
                cur.execute(
                    "INSERT INTO findings (host, port, service, severity, source, import_date) VALUES (?, ?, ?, ?, ?, ?)",
                    (addr, portid, name, "info", "nmap", datetime.now().isoformat())
                )
        conn.commit()
        conn.close()
        append_status(f"Parsed and ingested Nmap XML results from {xml_file}")
    except Exception as e:
        append_status(f"XML ingest failed: {e}")


