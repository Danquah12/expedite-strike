                multiple=False
            )
        ], width=3),
    ], className="mb-3"),

    dbc.Button("▶️ Start Scan", id="scan-btn", color="warning", className="mb-3"),
    html.Pre(id="scan-status", style={"backgroundColor": "#111", "color": "#EAAA00", "padding": "10px"}),

    html.Hr(),
    html.H5("📥 CSV Import / Export"),
    dbc.Row([
        dbc.Col([
            dcc.Upload(
                id="csv-upload",
                children=html.Div(["📄 Upload findings.csv"]),
                style={
                    "width": "100%", "height": "40px", "lineHeight": "40px",
                    "borderWidth": "1px", "borderStyle": "dashed",
                    "borderRadius": "5px", "textAlign": "center",
                    "backgroundColor": "#222", "color": "#EAAA00"
                },
                multiple=False
            )
        ], width=6),
        dbc.Col([
            html.A("⬇️ Download current findings.csv", href="/download_csv", target="_blank",
                   className="btn btn-warning")
        ], width=6)
    ])
])


# ----------------------------
# Assessment Callbacks
# ----------------------------
@app.callback(
    Output("scan-status", "children"),
    Input("scan-btn", "n_clicks"),
    State("scanner-select", "value"),
    State("target-input", "value"),
    State("target-upload", "contents"),
    prevent_initial_call=True
)
def trigger_scan(n, scanner, targets_text, uploaded_file):
    if not scanner:
        return "⚠️ Please select a scanner."

    targets = []
    if uploaded_file:
        content_type, content_string = uploaded_file.split(",")
        decoded = base64.b64decode(content_string).decode("utf-8")
        targets = [t.strip() for t in decoded.splitlines() if t.strip()]
    elif targets_text:
        targets = [t.strip() for t in targets_text.split(",") if t.strip()]

    allowed = [t for t in targets if allowed_target(t)]
    if not allowed:
        return "⚠️ No valid targets (must match whitelisted ranges)."

    if scanner == "nmap":
        xml_path = run_nmap_scan(allowed)
        parse_and_ingest(xml_path)
        return f"Nmap scan complete. Results imported from {xml_path}."

    return f"{scanner} scanner selected — integration placeholder."


# ----------------------------
# CSV Import Callback
# ----------------------------
@app.callback(
    Output("scan-status", "children", allow_duplicate=True),
    Input("csv-upload", "contents"),
    prevent_initial_call=True
)
def upload_csv(content):
    if not content:
        raise dash.exceptions.PreventUpdate
    try:
        content_type, content_string = content.split(",")
        decoded = base64.b64decode(content_string).decode("utf-8")
        df = pd.read_csv(pd.compat.StringIO(decoded))
        conn = sqlite3.connect(DB_PATH)
        df.to_sql("findings", conn, if_exists="append", index=False)
        conn.close()
        append_status("CSV findings imported successfully.")
        return "✅ CSV imported and added to findings.db"
    except Exception as e:
        return f"CSV import failed: {e}"



