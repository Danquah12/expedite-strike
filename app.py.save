# ==========================================================
# 11️⃣ Callbacks: Filtering + CSV Import/Export
# ==========================================================
@app.callback(
    Output("vuln-table", "data"),
    Input("src-filter", "value"),
    Input("sev-filter", "value"),
    Input("ip-filter", "value")
)
def filter_table(srcs, sevs, ips):
    df = load_findings()
    if df.empty:
        raise dash.exceptions.PreventUpdate
    if srcs: df = df[df["source"].isin(srcs)]
    if sevs: df = df[df["severity"].isin(sevs)]
    if ips: df = df[df["host"].isin(ips)]
    return df.to_dict("records")

@app.callback(
    Output("csv-status", "children"),
    Input("export-btn", "n_clicks"),
    Input("upload-csv", "contents"),
    prevent_initial_call=True
)
def handle_csv(n_export, upload_content):
    trig = ctx.triggered_id
    if trig == "export-btn":
        return export_findings_to_csv()
    elif trig == "upload-csv" and upload_content:
        return import_csv_to_findings(upload_content)
    return dash.no_update

