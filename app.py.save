#  GRAPH VIEW TAB — Neo4j Integration + Visualization
# ==========================================================

from neo4j import GraphDatabase

# --- Neo4j Config ---
NEO4J_URI = "bolt://localhost:7687"
NEO4J_USER = "neo4j"
NEO4J_PW = "Adomaa12@"

# --- Helper: Neo4j Connection ---
def push_findings_to_neo4j():
    """Push current SQLite findings into Neo4j."""
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql_query("SELECT host, port, service, severity, cve_id, source FROM findings", conn)
        conn.close()

        driver = GraphDatabase.driver(NEO4J_URI, auth=(NEO4J_USER, NEO4J_PW))
        with driver.session() as session:
            session.run("MATCH (n) DETACH DELETE n")  # reset for clean sync
            for _, row in df.iterrows():
                cypher = """
                MERGE (a:Asset {host:$host})
                MERGE (v:Vulnerability {cve_id:COALESCE($cve_id, 'Unknown'), severity:$severity, source:$source})
                MERGE (a)-[:HAS_VULNERABILITY]->(v)
                """
                session.run(cypher, dict(
                    host=row["host"],
                    cve_id=row["cve_id"],
                    severity=row["severity"],
                    source=row["source"]
                ))
        driver.close()
        append_status("Neo4j graph updated successfully.")
        return "✅ Neo4j sync complete!"
    except Exception as e:
        append_status(f"Neo4j sync failed: {e}")
        return f"❌ Neo4j error: {e}"


def get_graph_summary():
    """Get a simple vulnerability count per host from Neo4j."""
    try:
        driver = GraphDatabase.driver(NEO4J_URI, auth=(NEO4J_USER, NEO4J_PW))
        with driver.session() as session:
            result = session.run("""
                MATCH (a:Asset)-[:HAS_VULNERABILITY]->(v:Vulnerability)
                RETURN a.host AS host, count(v) AS vulns
                ORDER BY vulns DESC
                LIMIT 20
            """)
            records = [{"host": r["host"], "vulns": r["vulns"]} for r in result]
        driver.close()
        return pd.DataFrame(records)
    except Exception as e:
        return pd.DataFrame([{"host": "Error", "vulns": str(e)}])


