REPORT_DIR = Path("/root/vuln_intel/app/data/reports")
REPORT_DIR.mkdir(parents=True, exist_ok=True)


class VulnPDF(FPDF):
    def header(self):
        self.set_fill_color(234, 170, 0)  # Towson gold
        self.rect(0, 0, 210, 20, 'F')
        self.set_font("Helvetica", "B", 14)
        self.set_text_color(0, 0, 0)
        self.cell(0, 10, "Towson University — Vulnerability Intelligence Report", ln=True, align="C")
        self.ln(10)

    def footer(self):
        self.set_y(-15)
        self.set_font("Helvetica", "I", 9)
        self.set_text_color(128)
        self.cell(0, 10, f"Page {self.page_no()}", align="C")

    def section_title(self, title):
        self.set_font("Helvetica", "B", 12)
        self.set_text_color(234, 170, 0)
        self.cell(0, 10, title, ln=True)
        self.ln(2)

    def section_body(self, text):
        self.set_font("Helvetica", "", 10)
        self.set_text_color(255)
        self.multi_cell(0, 6, text)
        self.ln()


def generate_pdf_report():
    """Generate host-by-host vulnerability report."""
    conn = sqlite3.connect(DB_PATH)
    df = pd.read_sql_query("SELECT * FROM findings", conn)
    conn.close()
    if df.empty:
        return None

    pdf = VulnPDF()
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.add_page()
    pdf.set_text_color(255, 255, 255)

    pdf.section_title("Scan Overview")
    pdf.section_body(f"Generated: {datetime.now().isoformat()}\nTotal Findings: {len(df)}")

    for host, group in df.groupby("host"):
        pdf.add_page()
        pdf.section_title(f"Host: {host}")
        summary = group.groupby("severity").size().to_string()
        pdf.section_body(f"Severity Summary:\n{summary}\n")

        for _, row in group.iterrows():
            pdf.section_body(
                f"Port: {row.get('port','N/A')} | Service: {row.get('service','N/A')}\n"
                f"CVE: {row.get('cve_id','N/A')} | Severity: {row.get('severity','N/A')}\n"
                f"Source: {row.get('source','N/A')}\n"
                f"Description: {row.get('description','N/A')}\n"
                f"Remediation: {row.get('remediation','N/A')}\n"
                "-----------------------------------------------"
            )

    report_path = REPORT_DIR / f"vuln_report_{int(time.time())}.pdf"
    pdf.output(str(report_path))
    append_status(f"PDF report created: {report_path}")
    return str(report_path)


