# Nmap import integration
# --------------------------------------------------------
from neo4j import GraphDatabase
import xml.etree.ElementTree as ET

def parse_nmap_xml(xml_path):
    """Parse Nmap XML results into a list of {host, services} dicts"""
    hosts = []
    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()
        for host in root.findall("host"):
            addr = host.find("address")
            if addr is None:
                continue
            ip = addr.get("addr")
            services = []
            for port in host.findall(".//port"):
                proto = port.get("protocol")
                portid = port.get("portid")
                svc_elem = port.find("service")
                name = svc_elem.get("name") if svc_elem is not None else "unknown"
                services.append({"name": name, "port": portid, "protocol": proto})
            hosts.append({"host": ip, "services": services})
    except Exception as e:
        print(f"[parse_nmap_xml] Error parsing {xml_path}: {e}")
    return hosts


def import_nmap_hosts_to_neo4j(hosts, neo4j_uri, user, password, gds_project_name=None):
    """Insert parsed Nmap hosts and services into Neo4j"""
    driver = GraphDatabase.driver(neo4j_uri, auth=(user, password))
    with driver.session() as session:
        # Ensure schema constraints exist
        session.run("CREATE CONSTRAINT IF NOT EXISTS FOR (a:Asset) REQUIRE a.host IS UNIQUE")
        session.run("CREATE CONSTRAINT IF NOT EXISTS FOR (s:Service) REQUIRE (s.name, s.port) IS UNIQUE")

        for h in hosts:
            host = h.get("host")
            session.run("MERGE (a:Asset {host:$host})", host=host)
            for svc in h.get("services", []):
                session.run("""
                    MERGE (a:Asset {host:$host})
                    MERGE (s:Service {name:$name, port:$port, protocol:$protocol})
                    MERGE (a)-[:RUNS_SERVICE]->(s)
                """, host=host, name=svc["name"], port=svc["port"], protocol=svc["protocol"])
    driver.close()
    print(f"✅ Imported {len(hosts)} host(s) into Neo4j.")
