# --- Wrapper for OpenAI responses with safe logging ---
def ai_response(prompt: str, *, model=OPENAI_MODEL, max_tokens=800):
    """
    Sends a prompt to OpenAI GPT and returns a response.
    If the API key isn't configured, provides guidance instead of failing.
    """

    # Audit logging for reproducibility
    try:
        audit_dir = os.path.join(PROJECT_ROOT, "app", "data")
        os.makedirs(audit_dir, exist_ok=True)
        audit_path = os.path.join(audit_dir, "llm_audit.log")
        with open(audit_path, "a") as f:
            f.write(f"{datetime.datetime.utcnow().isoformat()} | model={model} | prompt_len={len(str(prompt))}\n")
    except Exception:
        pass

    if not OPENAI_AVAILABLE:
        return (
            "⚠️ OpenAI not configured. Set the OPENAI_API_KEY environment variable to enable LLM features.\n"
            "Example (temporary):\n  OPENAI_API_KEY=\"sk-...\" python3 app.py\n"
        )

    try:
        # Works across most OpenAI SDK versions
        resp = openai.ChatCompletion.create(
            model=model,
            messages=[{"role": "user", "content": prompt}],
            max_tokens=max_tokens
        )

        # Handle response regardless of SDK version
        if isinstance(resp, dict) and "choices" in resp:
            return resp["choices"][0]["message"]["content"]
        elif hasattr(resp, "choices"):
            return resp.choices[0].message.content
        else:
            return str(resp)
    except Exception as e:
        return f"[AI Error] {e}"


