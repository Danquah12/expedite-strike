def load_findings():
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql_query("SELECT * FROM findings", conn)
        conn.close()
        return df
    except Exception as e:
        print(f"[!] DB load error: {e}")
        return pd.DataFrame()

def mitre_mapping(port):
    mapping = {
        21: ("T1021.002", "FTP Remote File Copy"),
        22: ("T1021.004", "SSH Remote Services"),
        23: ("T1048.003", "Exfiltration Over Telnet"),
        25: ("T1071.003", "Exfiltration via SMTP"),
        80: ("T1190", "Exploit Public-Facing Application"),
        443: ("T1071.001", "Exfiltration Over HTTPS"),
        3306: ("T1505.003", "SQL Database Exploitation"),
        3389: ("T1021.001", "RDP Remote Services"),
    }
    return mapping.get(port, ("T1046", "Network Service Scanning"))

def generate_pdf_report(df, filename="assessment_report.pdf"):
    pdf = FPDF()
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.add_page()
    pdf.set_font("Arial", "B", 14)
    pdf.cell(0, 10, "Towson University Cybersecurity Research Project", ln=True)
    pdf.set_font("Arial", "", 12)
    pdf.multi_cell(0, 10, f"Generated On: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    pdf.multi_cell(0, 10, "AI-Augmented Vulnerability Assessment (MITRE Mappings Included)")
    pdf.ln(5)
    for _, row in df.iterrows():
        pdf.cell(0, 10, f"Host: {row.get('host','N/A')} | Port: {row.get('port','N/A')} | CVSS: {row.get('cvss','N/A')}", ln=True)
        pdf.multi_cell(0, 8, f"Description: {row.get('description','N/A')}")
        pdf.multi_cell(0, 8, f"Remediation: {row.get('remediation','N/A')}")
        pdf.ln(5)
    out_path = os.path.join(REPORT_DIR, filename)
    pdf.output(out_path)
    return out_path

