@app.callback(
    [Output("cvss-dist", "figure"), Output("findings-table", "data")],
    [Input("source-filter", "value"), Input("severity-filter", "value"), Input("ip-filter", "value")]
)
def update_dashboard(source, severity, ip):
    df = load_findings()
    if df.empty:
        return px.bar(title="No Data"), []
    if source: df = df[df["source"] == source]
    if severity: df = df[df["severity"] == severity]
    if ip: df = df[df["host"] == ip]
    fig = px.histogram(df, x="cvss", color="severity", nbins=10, title="CVSS Score Distribution")
    return fig, df.to_dict("records")

