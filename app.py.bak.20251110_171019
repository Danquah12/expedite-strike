@app.callback(Output("nl-output", "children"), Input("nl-btn", "n_clicks"), State("nl-query", "value"))
def natural_language(n, query):
    if not n or not query:
        return "Type your query and click Process."
    df = load_findings()
    if "critical" in query.lower():
        result = df[df["severity"].str.lower() == "critical"]
    elif "high" in query.lower():
        result = df[df["severity"].str.lower() == "high"]
    else:
        result = df.head(10)
    return result.to_string(index=False)

@app.callback(Output("chat-response", "children"), Input("chat-submit", "n_clicks"), State("chat-input", "value"))
def chatbot_response(n, question):
    if not n or not question:
        return "Ask something to begin."
    df = load_findings()
    summary = f"The dataset contains {len(df)} findings. Use filters for deeper insights."
    return ai_response(f"Answer this question using vulnerability data context: {question}\nDataset summary: {summary}")

@app.callback(
    [Output("assess-output", "children"), Output("export-path", "children")],
    [Input("assess-run", "n_clicks"), Input("export-report", "n_clicks")],
    State("include-mitre", "value")
)
def run_assessment(run_n, export_n, include_mitre):
    ctx = dash.callback_context
    if not ctx.triggered:
        return "", ""
    action = ctx.triggered[0]["prop_id"].split(".")[0]
    df = load_findings()
    if df.empty:
        return "No findings available.", ""
    if action == "assess-run":
        report_lines = []
        for _, row in df.iterrows():
            port = int(row.get("port", 0) or 0)
            tech_id, technique = mitre_mapping(port)
            if include_mitre:
                line = f"Host {row.get('host')} (Port {port}): {technique} [{tech_id}]"
            else:
                line = f"Host {row.get('host')} (Port {port})"
            report_lines.append(line)
        text = "\n".join(report_lines)
        return text, ""
    elif action == "export-report":
        path = generate_pdf_report(df)
        return "", f"PDF exported to: {path}"

@app.callback(Output("report-output", "children"), Input("report-btn", "n_clicks"))
def reporting(n):
    if not n:
        return "Click to generate summary."
    df = load_findings()
    content = f"Research Report Summary\nRecords: {len(df)}\nGenerated: {datetime.datetime.now()}"
    path = os.path.join(REPORT_DIR, "summary.md")
    with open(path, "w") as f:
        f.write(content)
    return f"Summary saved to {path}"

@app.callback(Output("voice-output", "children"), Input("voice-btn", "n_clicks"))
def voice_command(n):
    if not n:
        return "Click 'Start Listening' to begin."
    recognizer = sr.Recognizer()
    try:
        with sr.Microphone() as source:
            audio = recognizer.listen(source, timeout=5)
            text = recognizer.recognize_google(audio)
            return f"You said: {text}\n\nResponse: {ai_response(text)}"
    except Exception as e:
        return f"[Voice Error] {e}"

