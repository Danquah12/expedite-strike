import xml.etree.ElementTree as ET

def parse_nmap_xml(xml_path):
    """
    Parse Nmap XML and return structured service records.
    Safe, clean, no duplication.
    """
    if not os.path.exists(xml_path):
        return []

    results = []
    tree = ET.parse(xml_path)
    root = tree.getroot()

    for host in root.findall("host"):
        addr_tag = host.find("address")
        if addr_tag is None:
            continue

        ip = addr_tag.get("addr")
        hostname = ""

        hname_tag = host.find("hostnames/hostname")
        if hname_tag is not None:
            hostname = hname_tag.get("name")

        # Loop all ports
        for port in host.findall("ports/port"):
            port_id = port.get("portid")
            proto = port.get("protocol")
            state = port.find("state").get("state")

            service_tag = port.find("service")
            service = service_tag.get("name") if service_tag is not None else ""
            product = service_tag.get("product") if service_tag is not None else ""
            version = service_tag.get("version") if service_tag is not None else ""

            results.append({
                "ip": ip,
                "hostname": hostname,
                "port": port_id,
                "protocol": proto,
                "state": state,
                "service": service,
                "product": product,
                "version": version,
            })

    return results


