# -------------------------------------------------------------
#  QUERY NVD API (Primary Source)
# -------------------------------------------------------------
def fetch_from_nvd(cve_id):
    try:
        url = f"https://services.nvd.nist.gov/rest/json/cve/2.0/{cve_id}"

        headers = {"apiKey": NVD_API_KEY} if NVD_API_KEY else {}

        print(f"[NVD] Fetching {cve_id} from NVD...")

        resp = requests.get(url, headers=headers, timeout=20)
        if resp.status_code != 200:
            print(f"[NVD] Error: {resp.status_code}")
            return None

        data = resp.json()
        return data
    except Exception as e:
        print(f"[NVD] Exception: {e}")
        return None


# -------------------------------------------------------------
#  CIRCL FALLBACK (Secondary Source)
# -------------------------------------------------------------
def fetch_from_circl(cve_id):
    try:
        url = f"{CIRCL_BASE}/{cve_id}"
        print(f"[CIRCL] Fallback for {cve_id}")

        resp = requests.get(url, timeout=20)
        if resp.status_code != 200:
            return None
        return resp.json()

    except Exception as e:
        print(f"[CIRCL] Exception: {e}")
        return None


# -------------------------------------------------------------
#  PARSE NVD/CIRCL RESPONSE INTO NORMALIZED STRUCTURE
# -------------------------------------------------------------
def parse_enrichment_response(cve_id, nvd_data, circl_data):
    enriched = {
        "cve": cve_id,
        "cvss": None,
        "severity": None,
        "description": "",
        "published": "",
        "vector": "",
        "cwe": "",
        "source": "",
    }

    # ---------- NVD (Primary) ----------
    if nvd_data:
        enriched["source"] = "NVD"

        try:
            item = nvd_data["vulnerabilities"][0]["cve"]

            # Description
            enriched["description"] = item["descriptions"][0]["value"]

            # CWE
            if "weaknesses" in item and item["weaknesses"]:
                enriched["cwe"] = item["weaknesses"][0]["description"][0]["value"]

            # CVSS 3.1
            metrics = item["metrics"]
            if "cvssMetricV31" in metrics:
                cv = metrics["cvssMetricV31"][0]["cvssData"]
                enriched["cvss"] = float(cv.get("baseScore", 0))
                enriched["severity"] = cv.get("baseSeverity")
                enriched["vector"] = cv.get("vectorString")

            enriched["published"] = item["published"]

        except Exception as e:
            print(f"[ENRICH] NVD parse error: {e}")

    # ---------- CIRCL (Fallback) ----------
    elif circl_data:
        enriched["source"] = "CIRCL"

        enriched["description"] = circl_data.get("summary", "")
        enriched["published"] = circl_data.get("Published", "")

        if "cvss" in circl_data:
            try:
                enriched["cvss"] = float(circl_data["cvss"])
                enriched["severity"] = (
                    "CRITICAL" if enriched["cvss"] >= 9 else
                    "HIGH" if enriched["cvss"] >= 7 else
                    "MEDIUM" if enriched["cvss"] >= 4 else "LOW"
                )
            except:
                pass

        enriched["cwe"] = circl_data.get("cwe", "")

    return enriched


# -------------------------------------------------------------
#  SAVE ENRICHMENT BACK INTO NEO4J
# -------------------------------------------------------------
def write_enrichment_to_neo4j(driver, enriched):
    try:
        with driver.session() as session:
            session.run(
                """
                MATCH (v:Vulnerability {id: $cve})
                SET v.cvss = $cvss,
                    v.severity = $severity,
                    v.description = $description,
                    v.published = $published,
                    v.vector = $vector,
                    v.cwe = $cwe,
                    v.enriched_from = $source,
                    v.last_enriched = $timestamp
                """,
                {
                    "cve": enriched["cve"],
                    "cvss": enriched["cvss"],
                    "severity": enriched["severity"],
                    "description": enriched["description"],
                    "published": enriched["published"],
                    "vector": enriched["vector"],
                    "cwe": enriched["cwe"],
                    "source": enriched["source"],
                    "timestamp": datetime.utcnow().isoformat(),
                }
            )
        print(f"[NEO4J] Updated CVE in graph: {enriched['cve']}")
    except Exception as e:
        print(f"[NEO4J] Failed to write CVE: {e}")


# -------------------------------------------------------------
#  MAIN ENRICHMENT FUNCTION (CVE → NVD → CIRCL → CACHE)
# -------------------------------------------------------------
def enrich_cve(cve_id, driver=None):
    cache = load_cve_cache()

    # Return cached if exists
    if cve_id in cache:
        return cache[cve_id]

    # Try NVD
    nvd_data = fetch_from_nvd(cve_id)

    # If NVD fails → CIRCL fallback
    circl_data = None if nvd_data else fetch_from_circl(cve_id)

    enriched = parse_enrichment_response(cve_id, nvd_data, circl_data)

    # Save to cache
    cache[cve_id] = enriched
    save_cve_cache(cache)

    # Write into Neo4j only if driver provided
    if driver:
        write_enrichment_to_neo4j(driver, enriched)

    return enriched


# -------------------------------------------------------------
#  BULK ENRICHMENT (for scans with many CVEs)
# -------------------------------------------------------------
def enrich_multiple_cves(cve_list, driver=None, limit=None):
    enriched = []

    count = 0
    for cve in cve_list:
        if limit and count >= limit:
            break
        enriched.append(enrich_cve(cve, driver))
        count += 1

    return enriched


