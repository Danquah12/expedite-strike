            return (
                "✅ Scan Complete\n\n"
                f"Targets: {', '.join(targets)}\n"
                f"XML Saved: {xml_path}\n\n"
                "----------- Live Output -----------\n"
                f"{live_output}"
            )

        except Exception as e:
