    Runs Nmap with XML output and streams all stdout live.
    Returns: (success_flag, raw_log_text)
    """
    cmd = [
        "nmap",
        "-sV",
        "-O",
        "-v",
        "-oX", output_xml_path,
    ] + targets

    print(f"[SCAN] Running Nmap: {' '.join(cmd)}")

    process = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )

    live_log = ""

    # Stream output as scan progresses
    for line in process.stdout:
        print(line, end="")
        live_log += line

    process.wait()
    success = (process.returncode == 0)

    return success, live_log


# -------------------------------------------------------------
#  PARSE NMAP XML
# -------------------------------------------------------------
def parse_nmap_xml(xml_path):
    """
    Reads an Nmap XML file and extracts all host + port + service records.
    Returns: List of dict items
    """
    if not os.path.exists(xml_path):
        print(f"[XML] File does not exist: {xml_path}")
        return []

    results = []

    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()

        for host in root.findall("host"):
            # IP Address
            address_tag = host.find("address")
            ip = address_tag.get("addr") if address_tag is not None else None

            # Optional hostname
            hostname = None
            hn = host.find("hostnames/hostname")
            if hn is not None:
                hostname = hn.get("name")

            # Process ports
            for port in host.findall("ports/port"):
                port_id = port.get("portid")
                proto = port.get("protocol")
                state = port.find("state").get("state")

                service_tag = port.find("service")
                if service_tag is not None:
                    service_name = service_tag.get("name", "")
                    product = service_tag.get("product", "")
                    version = service_tag.get("version", "")
                else:
                    service_name, product, version = "", "", ""

                results.append({
                    "ip": ip,
                    "hostname": hostname,
                    "port": port_id,
                    "protocol": proto,
                    "state": state,
                    "service": service_name,
                    "product": product,
                    "version": version
                })

        print(f"[XML] Parsed {len(results)} records from scan.")
        return results

    except Exception as e:
        print(f"[XML] Parsing failed: {e}")
        return []


