class Neo4jQueryEngine:
    """
    All graph queries used by the Enterprise Dashboard.
    Category + Graph Type → Cypher query builder.
    """

    def __init__(self, uri="bolt://localhost:7687", user="neo4j", password="Adomaa12@"):
        self.uri = uri
        self.user = user
        self.password = password

    # -------------------------------------------------------------
    # Base connection
    # -------------------------------------------------------------
    def _connect(self):
        try:
            return GraphDatabase.driver(self.uri, auth=(self.user, self.password))
        except Exception as e:
            print(f"[NEO4J] Connection error: {e}")
            return None

    # -------------------------------------------------------------
    # Run query safely
    # -------------------------------------------------------------
    def run(self, cypher, params=None):
        drv = self._connect()
        if not drv:
            return []

        try:
            with drv.session() as session:
                data = list(session.run(cypher, params or {}))
                return data
        except Exception as e:
            print(f"[NEO4J] Query failed: {e}")
            return []
        finally:
            drv.close()

    # -------------------------------------------------------------
    # Graph Factory — SELECT query based on graph type
    # -------------------------------------------------------------
    def build_query(self, category, gtype):
        """
        Determines the correct Cypher query for each graph type.
        """
        if category == "Core Relationship Graphs":
            return self._core_graphs(gtype)

        if category == "Network Topology Graphs":
            return self._network_graphs(gtype)

        if category == "Attack Path Graphs":
            return self._attack_graphs(gtype)

        if category == "Vulnerability Exposure Graphs":
            return self._vuln_exposure_graphs(gtype)

        if category == "Service & Port Mapping Graphs":
            return self._service_graphs(gtype)

        if category == "CVE Intelligence Graphs":
            return self._cve_intel_graphs(gtype)

        if category == "Asset Inventory Graphs":
            return self._asset_inventory_graphs(gtype)

        return None

    # -------------------------------------------------------------
    # CATEGORY: Core Relationship Graphs
    # -------------------------------------------------------------
    def _core_graphs(self, gtype):
        if gtype == "Asset-Service-Vulnerability Graph":
            return """
                MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
                OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
                RETURN a, s, v
            """
        if gtype == "Service-Port Graph":
            return """
                MATCH (s:Service)
                RETURN s
            """
        return None

    # -------------------------------------------------------------
    # CATEGORY: Network Topology
    # -------------------------------------------------------------
    def _network_graphs(self, gtype):
        if gtype == "Network Topology Map":
            return """
                MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
                RETURN a, s
            """
        if gtype == "Host Connectivity Graph":
            return """
                MATCH (a:Asset)-[:CONNECTED_TO]->(b:Asset)
                RETURN a, b
            """
        return None

    # -------------------------------------------------------------
    # CATEGORY: Attack Path Graphs
    # -------------------------------------------------------------
    def _attack_graphs(self, gtype):
        if gtype == "Potential Attack Paths":
            return """
                MATCH p = (a:Asset)-[*1..5]->(v:Vulnerability)
                RETURN p
            """
        if gtype == "Lateral Movement Graph":
            return """
                MATCH (a:Asset)-[:COMPROMISES]->(b:Asset)
                RETURN a, b
            """
        return None

    # -------------------------------------------------------------
    # CATEGORY: Vulnerability Exposure Graphs
    # -------------------------------------------------------------
    def _vuln_exposure_graphs(self, gtype):
        if gtype == "Critical Asset Exposure Graph":
            return """
                MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
                WHERE v.cvss >= 9.0
                RETURN a, s, v
            """
        if gtype == "Vulnerability Cluster Graph":
            return """
                MATCH (v:Vulnerability)-[:RELATED_TO]->(o:Vulnerability)
                RETURN v, o
            """
        return None

    # -------------------------------------------------------------
    # CATEGORY: Service & Port Graphs
    # -------------------------------------------------------------
    def _service_graphs(self, gtype):
        if gtype == "Open Port Map":
            return """
                MATCH (s:Service)
                RETURN s
            """
        if gtype == "Service Misconfiguration Graph":
            return """
                MATCH (s:Service {version:'unknown'})
                RETURN s
            """
        return None

    # -------------------------------------------------------------
    # CATEGORY: CVE Intelligence Graphs
    # -------------------------------------------------------------
    def _cve_intel_graphs(self, gtype):
        if gtype == "CVE-CVSS Graph":
            return """
                MATCH (v:Vulnerability)
                RETURN v
            """
        if gtype == "CVE-Exploit Graph":
            return """
                MATCH (v:Vulnerability)-[:EXPLOITED_BY]->(e:Exploit)
                RETURN v, e
            """
        return None

    # -------------------------------------------------------------
    # CATEGORY: Asset Inventory Graphs
    # -------------------------------------------------------------
    def _asset_inventory_graphs(self, gtype):
        if gtype == "Complete Asset Map":
            return """
                MATCH (a:Asset)
                RETURN a
            """
        if gtype == "Installed Software Graph":
            return """
                MATCH (a:Asset)-[:HAS_SOFTWARE]->(s:Software)
                RETURN a, s
            """
        return None

