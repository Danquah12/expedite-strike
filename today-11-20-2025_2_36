# --------------------------------------------------------
#  Callback 2:
#  Render Graph (Single Unified Graph Engine)
#  No duplicates — this is the ONLY graph renderer.
# --------------------------------------------------------
@app.callback(
    Output("neo4j-graph", "elements"),
    Output("graph-status", "children"),
    Input("graph-generate-btn", "n_clicks"),
    State("graph-category", "value"),
    State("graph-type", "value"),
    prevent_initial_call=True
)
def render_graph(n_clicks, category, gtype):
    """
    Generate Neo4j graphs based on selected category + graph type.
    Unified renderer — NO duplicate callbacks.
    """
    if not n_clicks:
        raise PreventUpdate

    if not category or not gtype:
        return [], "⚠️ Select a category and graph type."

    print(f"[Graph] Rendering: {category} → {gtype}")

    try:
        driver = GraphDatabase.driver(NEO4J_URI, auth=(NEO4J_USER, NEO4J_PASS))

        # ----------------------------
        # Build dynamic Cypher query
        # ----------------------------
        qmap = {
            "Asset-Service-Vulnerability Graph": """
                MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
                OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
                RETURN a,s,v
            """,

            "Service-Port Graph": """
                MATCH (s:Service)
                RETURN s
            """,

            "Asset-Vulnerability Impact Graph": """
                MATCH (a:Asset)-[:RUNS_SERVICE]->(:Service)-[:HAS_VULNERABILITY]->(v:Vulnerability)
                RETURN a,v
            """,

            "Network Topology Map": """
                MATCH (a:Asset)-[:DISCOVERED]->(b:Asset)
                RETURN a,b
            """
        }

        if gtype not in qmap:
            return [], f"⚠️ Graph type not implemented yet: {gtype}"

        cypher = qmap[gtype]

        with driver.session() as session:
            rows = list(session.run(cypher))

        driver.close()

        # ----------------------------
        # Build Cytoscape Elements
        # ----------------------------
        nodes = {}
        edges = []

        for r in rows:
            for key in r.keys():
                item = r[key]
                if item is None:
                    continue

                # ---- Node label ----
                label = list(item.labels)[0] if hasattr(item, "labels") else "Node"
                nid = item.id

                if nid not in nodes:
                    nodes[nid] = {
                        "data": {
                            "id": str(nid),
                            "label": f"{label}: {item.get('name', item.get('host', ''))}"
                        },
                        "classes": label.lower()
                    }

            # ---- Relationships (only if record includes two nodes) ----
            if len(r.keys()) == 2:
                keys = list(r.keys())
                a = r[keys[0]]
                b = r[keys[1]]
                if hasattr(a, "id") and hasattr(b, "id"):
                    edges.append({
                        "data": {"source": str(a.id), "target": str(b.id)}
                    })

        elements = list(nodes.values()) + edges

        if not elements:
            return [], "⚠️ No graph data found."

        return elements, f"✅ {gtype} generated successfully."

    except Exception as e:
        print(f"[Graph Error] {e}")
        return [], f"❌ Neo4j error: {str(e)}"


