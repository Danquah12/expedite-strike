class GraphRenderer:
    """
    Converts Neo4j Node/Relationship results → Cytoscape format.
    Handles:
        ✔ node shaping (assets/services/vulns)
        ✔ colors
        ✔ size weighting (CVSS/degree)
        ✔ edge styling
    """

    def __init__(self):
        # Towson gold/black theme
        self.colors = {
            "asset": "#28a745",
            "service": "#007bff",
            "vuln": "#dc3545",
            "software": "#8e44ad",
            "exploit": "#e74c3c",
            "default": "#EAAA00"
        }

    # -------------------------------------------------------------
    # Convert Neo4j results → Cytoscape elements
    # -------------------------------------------------------------
    def convert(self, records):
        nodes = {}
        edges = []

        for rec in records:
            # Neo4j returns objects, extract them
            for key, val in rec.items():
                if hasattr(val, "id") and hasattr(val, "labels"):   # Node
                    nid = str(val.id)
                    label = list(val.labels)[0] if val.labels else "Node"
                    name = val.get("name") or val.get("host") or val.get("id") or label

                    if nid not in nodes:
                        nodes[nid] = self._make_node(nid, name, label)

                # Relationships path (like MATCH p=...)
                if "p" in rec:
                    path = rec["p"]
                    for r in path.relationships:
                        edges.append(self._make_edge(r))

                # Single relationship from key match
                if hasattr(val, "type"):  
                    edges.append(self._make_edge(val))

        return list(nodes.values()) + edges

    # -------------------------------------------------------------
    # Create Cytoscape node
    # -------------------------------------------------------------
    def _make_node(self, nid, label, ntype):
        color = self._color_for_type(ntype)

        return {
            "data": {
                "id": nid,
                "label": label,
                "type": ntype
            },
            "classes": ntype.lower(),
            "style": {
                "background-color": color,
                "color": "#ffffff",
                "border-width": 2,
                "border-color": "#EAAA00"
            }
        }

    # -------------------------------------------------------------
    # Create Cytoscape edge
    # -------------------------------------------------------------
    def _make_edge(self, rel):
        return {
            "data": {
                "id": f"e{rel.id}",
                "source": str(rel.start_node.id),
                "target": str(rel.end_node.id),
                "label": rel.type
            },
            "style": {
                "line-color": "#888",
                "width": 2
            }
        }

    # -------------------------------------------------------------
    # Resolve color by Neo4j label type
    # -------------------------------------------------------------
    def _color_for_type(self, t):
        t = t.lower()
        if "asset" in t:
            return self.colors["asset"]
        if "service" in t:
            return self.colors["service"]
        if "vulnerability" in t:
            return self.colors["vuln"]
        if "software" in t:
            return self.colors["software"]
        if "exploit" in t:
            return self.colors["exploit"]
        return self.colors["default"]


