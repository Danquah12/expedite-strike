def normalize_asset(ip, hostname=None, os_name=None):
    """Insert or update an asset."""
    now = datetime.now().isoformat()

    existing = db_query("SELECT id FROM assets WHERE ip = ?", (ip,))
    if existing:
        db_execute(
            "UPDATE assets SET hostname=?, os=?, last_seen=? WHERE id=?",
            (hostname, os_name, now, existing[0]["id"])
        )
        return existing[0]["id"]

    db_execute(
        "INSERT INTO assets (ip, hostname, os, last_seen) VALUES (?, ?, ?, ?)",
        (ip, hostname, os_name, now)
    )
    new_id = db_query("SELECT id FROM assets WHERE ip=?", (ip,))
    return new_id[0]["id"]


def normalize_service(asset_id, port, protocol, state, service, product, version):
    """Insert service detected in scans."""
    db_execute(
        """
        INSERT INTO services (asset_id, port, protocol, state, service, product, version)
        VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (asset_id, port, protocol, state, service, product, version)
    )

    row = db_query(
        "SELECT id FROM services WHERE asset_id=? AND port=? AND protocol=? ORDER BY id DESC LIMIT 1",
        (asset_id, port, protocol)
    )
    return row[0]["id"] if row else None


def normalize_vulnerability(asset_id, service_id, cve, severity, cvss, description, source):
    """Store unified vulnerabilities."""
    db_execute(
        """
        INSERT INTO vulnerabilities (asset_id, service_id, cve, severity, cvss, description, source)
        VALUES (?, ?, ?, ?, ?, ?, ?)
