def convert_rows_to_elements(rows):
    """
    Convert Neo4j query output into Cytoscape elements.
    """

    nodes = {}
    edges = []

    for r in rows:

        # Asset
        if "asset" in r and r["asset"]:
            aid = r["asset"]
            nodes[aid] = {"data": {"id": aid, "label": f"Asset\n{aid}"}, "classes": "asset"}

        # Service
        if "service" in r and r["service"]:
            sid = f"{r['service']}:{r.get('port','')}"
            nodes[sid] = {"data": {"id": sid, "label": f"Service\n{sid}"}, "classes": "service"}

            if "asset" in r and r["asset"]:
                edges.append({"data": {"source": r["asset"], "target": sid}})

        # Vulnerability
        if "vuln" in r and r["vuln"]:
            vid = r["vuln"]
            nodes[vid] = {"data": {"id": vid, "label": f"Vuln\n{vid}"}, "classes": "vulnerability"}

            if "service" in r and r["service"]:
                sid = f"{r['service']}:{r.get('port','')}"
                edges.append({"data": {"source": sid, "target": vid}})

    return list(nodes.values()) + edges, f"✅ Graph loaded: {len(nodes)} nodes, {len(edges)} edges"


