            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            r["ip"], r["hostname"], r["port"], r["protocol"],
            r["state"], r["service"], r["product"], r["version"]
        ))

    conn.commit()
    conn.close()


