def parse_nmap_xml(xml_path):
    """Parse Nmap XML and return list of service dictionaries."""
    if not os.path.exists(xml_path):
        return []

    results = []
    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()

        for host in root.findall("host"):
            # IP Address
            addr_tag = host.find("address")
            if addr_tag is None:
                continue
            ip = addr_tag.get("addr")

            # Hostname
            hostname = None
            hn = host.find("hostnames/hostname")
            if hn is not None:
                hostname = hn.get("name")

            # OS detection (optional)
            os_match = host.find("os/osmatch")
            os_name = os_match.get("name") if os_match is not None else None

            # Normalize asset
            asset_id = normalize_asset(ip, hostname, os_name)

            # Iterate ports
            for port in host.findall("ports/port"):
                port_id = port.get("portid")
                proto = port.get("protocol")

                state_tag = port.find("state")
                state = state_tag.get("state") if state_tag is not None else None

                svc_tag = port.find("service")
                service_name = svc_tag.get("name") if svc_tag is not None else ""
                product = svc_tag.get("product") if svc_tag is not None else ""
                version = svc_tag.get("version") if svc_tag is not None else ""

                # Normalize into service table
                service_id = normalize_service(
                    asset_id, port_id, proto, state, service_name, product, version
                )

                # Store unified finding (no CVE yet)
                store_finding(
                    asset=ip,
                    port=port_id,
                    service=service_name,
                    version=version,
                    cve=None,
                    severity=None,
                    cvss=None,
                    cpe=None,
                    description=f"{service_name} {product} {version}".strip()
                )

                # Append raw object for return
                results.append({
                    "ip": ip,
                    "hostname": hostname,
                    "os": os_name,
                    "port": port_id,
                    "protocol": proto,
                    "state": state,
                    "service": service_name,
                    "product": product,
                    "version": version,
                })

    except Exception as e:
        print(f"[NMAP XML ERROR] {e}")

    return results


def run_nmap(targets, import_to_neo4j=False):
    """
    Execute Nmap with XML output and live streaming to terminal + dashboard.
    Returns tuple: (output_log, xml_path, parsed_results)
    """

    # Ensure scan directory
    os.makedirs(SCANS_DIR, exist_ok=True)

    timestamp = int(time.time())
    xml_output = f"{SCANS_DIR}/nmap_scan_{timestamp}.xml"

    # Full-featured scan settings
    cmd = [
        "nmap", "-sV", "-O", "-T4", "-p-", "-v",
        "-oX", xml_output
    ] + targets

    print(f"[NMAP] Running: {' '.join(cmd)}")

    live_output = ""
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True
        )

        # Stream output
        for line in proc.stdout:
            print(line, end="")
            live_output += line

        proc.wait()

    except Exception as e:
        live_output += f"\n[ERROR] Nmap failed: {e}\n"
        return live_output, None, []

    # Parse XML
    parsed_results = parse_nmap_xml(xml_output)

    # Auto-import into Neo4j
    if import_to_neo4j:
        try:
            import_nmap_hosts_to_neo4j(parsed_results)
        except Exception as e:
            print(f"[NEO4J IMPORT ERROR] {e}")

    return live_output, xml_output, parsed_results


