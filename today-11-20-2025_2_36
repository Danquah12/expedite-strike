def neo4j_create_asset(tx, ip, hostname=None, os_name=None):
    tx.run(
        """
        MERGE (a:Asset {ip: $ip})
        SET a.hostname = $hostname,
            a.os = $os,
            a.last_seen = datetime()
        """,
        ip=ip, hostname=hostname, os=os_name
    )


def neo4j_create_service(tx, ip, port, protocol, service, product, version):
    tx.run(
        """
        MATCH (a:Asset {ip: $ip})
        MERGE (s:Service {id: $sid})
        SET s.port = $port,
            s.protocol = $protocol,
            s.service = $service,
            s.product = $product,
            s.version = $version
        MERGE (a)-[:RUNS_SERVICE]->(s)
        """,
        ip=ip,
        sid=f"{ip}:{port}",
        port=port,
        protocol=protocol,
        service=service,
        product=product,
        version=version
    )


def neo4j_create_vulnerability(tx, ip, port, cve, cvss, severity, description):
    tx.run(
        """
        MATCH (a:Asset {ip: $ip})
        MATCH (s:Service {id: $sid})
        MERGE (v:Vulnerability {id: $cve})
        SET v.cvss = $cvss,
            v.severity = $severity,
            v.description = $description
        MERGE (s)-[:HAS_VULNERABILITY]->(v)
        """,
        ip=ip,
        sid=f"{ip}:{port}",
        cve=cve,
        cvss=cvss,
        severity=severity,
        description=description,
    )


