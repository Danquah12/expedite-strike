def import_nmap_hosts_to_neo4j(parsed_results):
    """Inserts parsed Nmap results into Neo4j."""
    driver = get_neo4j_driver()
    if not driver:
        return False

    print(f"[NEO4J] Importing {len(parsed_results)} Nmap service records...")

    try:
        with driver.session() as session:
            for r in parsed_results:
                ip       = r["ip"]
                hostname = r["hostname"]
                os_name  = r["os"]
                port     = r["port"]
                protocol = r["protocol"]
                service  = r["service"]
                product  = r["product"]
                version  = r["version"]

                session.write_transaction(neo4j_create_asset, ip, hostname, os_name)
                session.write_transaction(
                    neo4j_create_service,
                    ip, port, protocol, service, product, version
                )

        print("[NEO4J] Import complete.")
        return True

    except Exception as e:
        print(f"[NEO4J IMPORT ERROR] {e}")
        return False


