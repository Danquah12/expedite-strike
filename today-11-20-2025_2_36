def run_graph_query(graph_type):
    """
    Returns elements (nodes + edges) based on selected graph type.
    This is the enterprise Neo4j Graph Engine.
    """

    with neo4j_driver().session() as session:

        # ---------------- Core Graphs ----------------
        if graph_type == "Asset-Service-Vulnerability Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, s.name AS service, s.port AS port, v.id AS vuln
            """

        elif graph_type == "Asset-Service Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            RETURN a.host AS asset, s.name AS service, s.port AS port
            """

        elif graph_type == "Asset-Only Graph":
            q = """ MATCH (a:Asset) RETURN a.host AS asset """

        elif graph_type == "Service-Only Graph":
            q = """ MATCH (s:Service) RETURN s.name AS service, s.port AS port """

        # ---------------- Network Topology ----------------
        elif graph_type == "Network Topology Map":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            RETURN a.host AS asset, s.port AS port
            """

        elif graph_type == "Port Exposure Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            RETURN a.host AS asset, s.port AS port
            """

        # ---------------- Vulnerability Graphs ----------------
        elif graph_type == "Critical Asset Exposure Graph":
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            WHERE v.cvss >= 7.0
            RETURN a.host AS asset, s.name AS service, v.id AS vuln
            """

        # ---------------- Attack Paths ----------------
        elif graph_type == "Potential Attack Paths":
            q = """
            MATCH p = (a:Asset)-[:RUNS_SERVICE]->(:Service)-[:HAS_VULNERABILITY]->(:Vulnerability)
            RETURN p
            """

        else:
            return [], f"❗ Graph type not implemented: {graph_type}"

        # ---------------- Execute query ----------------
        rows = list(session.run(q))

    print(f"[GRAPH] Query returned {len(rows)} rows for: {graph_type}")
    return convert_rows_to_elements(rows)


