def import_services_to_neo4j(service_rows):
    """
    Accepts parsed service records from Nmap and inserts
    into Neo4j as:
        (Asset)-[:RUNS_SERVICE]->(Service)-[:LISTENS_ON]->(Port)
    """

    if not service_rows:
        print("[NEO4J] No services to import.")
        return

    query = """
    MERGE (a:Asset {host: $ip})
    MERGE (s:Service {name: $service, port: $port})
        ON CREATE SET s.product = $product, s.version = $version
        ON MATCH SET s.product = COALESCE(s.product, $product),
                      s.version = COALESCE(s.version, $version)
    MERGE (a)-[:RUNS_SERVICE]->(s)
    """

    driver = neo4j_driver()

    try:
        with driver.session() as session:
            for row in service_rows:
                session.run(query, {
                    "ip": row["ip"],
                    "service": row["service"] or "unknown",
                    "port": row["port"],
                    "product": row["product"] or "",
                    "version": row["version"] or "",
                })
        print(f"[NEO4J] Imported {len(service_rows)} service records.")

    except Exception as e:
        print(f"[NEO4J] Import error: {e}")

    driver.close()


