    State("graph-category", "value"),
    State("graph-type", "value"),
    prevent_initial_call=True
)
def generate_graph(n, category, gtype):
    if not gtype:
        return [], "⚠️ Please select a graph type."

    try:
        uri = "bolt://localhost:7687"
        driver = GraphDatabase.driver(uri, auth=("neo4j", "Adomaa12@"))

        with driver.session() as session:
            # --- Example universal graph query ---
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            OPTIONAL MATCH (s)-[:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, s.name AS service, s.port AS port,
                   v.id AS vuln, v.cvss AS cvss
            """

            data = list(session.run(q))

        nodes = []
        edges = []

        for rec in data:
            asset = rec["asset"]
            service = rec["service"]
            port = rec["port"]
            vuln = rec["vuln"]

            if asset:
                nodes.append({"data": {"id": asset, "label": "Asset"}})

            if service:
                sid = f"{service}:{port}"
                nodes.append({"data": {"id": sid, "label": "Service"}})
                edges.append({"data": {"source": asset, "target": sid}})

            if vuln:
                nodes.append({"data": {"id": vuln, "label": "Vulnerability"}})
                edges.append({"data": {"source": sid, "target": vuln}})

        # Deduplicate nodes
        unique = {n["data"]["id"]: n for n in nodes}
        elements = list(unique.values()) + edges

        return elements, f"✅ Loaded graph: {gtype}"

    except Exception as e:
        return [], f"❌ Neo4j Error: {str(e)}"


