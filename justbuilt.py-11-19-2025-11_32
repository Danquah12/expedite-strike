def build_stylesheet(theme_name):
    theme = GRAPH_THEMES.get(theme_name, GRAPH_THEMES["themeA"])
    stylesheet = []

    for node_type, props in theme.items():
        if node_type == "edges":
            continue

        stylesheet.append({
            "selector": f'node[label = "{node_type}"]',
            "style": {
                "background-color": props["color"],
                "shape": props["shape"],
                "width": props["size"],
                "height": props["size"],
                "label": "data(id)",
                "color": "#ffffff",
                "font-size": "10px",
                "text-wrap": "wrap",
            },
        })

    for edge_type, color in theme["edges"].items():
        stylesheet.append({
            "selector": f'edge[type = "{edge_type}"]',
            "style": {
                "line-color": color,
                "target-arrow-color": color,
                "target-arrow-shape": "triangle",
                "width": 2,
            }
        })

    return stylesheet


# ==========================================================
#  BATCH 7 — AUTO NODE & EDGE TYPE MAPPER
# ==========================================================

import re

def classify_node(node_id, properties=None):
    """
    Detect node type based on ID patterns or attributes.
    """
    if properties is None:
        properties = {}

    nid = str(node_id).lower()

    # --- Asset / Host detection ---
    if re.match(r"^\d{1,3}(\.\d{1,3}){3}$", node_id):
        return "Asset"
    if "host" in nid or "asset" in nid:
        return "Asset"

    # --- Service detection ---
    if ":" in node_id and re.match(r".+:\d+$", node_id):
        return "Service"

    # --- Port detection ---
    if nid.isdigit():
        return "Port"

    # --- CVE detection ---
    if re.match(r"cve-\d{4}-\d+", nid):
        return "CVE"

    # --- CWE detection ---
    if re.match(r"cwe-\d+", nid):
        return "CWE"

    # --- Exploit or attack tool ---
    if "exploit" in nid or "poc" in nid or "edb" in nid:
        return "Exploit"

    # --- Vulnerability fallback ---
    if "vuln" in nid or "ms" in nid or "kb" in nid:
        return "Vulnerability"

    # --- Attack path node ---
    if "path" in nid or properties.get("is_path"):
        return "Path"

    # Default fallback
    return "Unknown"


def classify_edge(rel_type, src_type=None, dst_type=None):
    """
    Normalize edge types so themes can color them correctly.
    """
    rel = rel_type.upper()

    # Common mappings
    if "RUNS" in rel:
        return "RUNS_SERVICE"

    if "HAS_VULN" in rel or "HAS_VULNERABILITY" in rel:
        return "HAS_VULNERABILITY"

    if "CONNECT" in rel or "LINK" in rel:
        return "CONNECTS_TO"

    if "DEPENDS" in rel:
        return "DEPENDS_ON"

    if "PATH" in rel or "ATTACK" in rel:
        return "ATTACK_PATH"

    if "CHAIN" in rel or "EXPLOIT" in rel:
        return "EXPLOIT_CHAIN"

    if "COMM" in rel:
        return "COMMUNICATES_WITH"

    # If source is Service and dest is CVE, auto-map
    if src_type == "Service" and dst_type == "Vulnerability":
        return "HAS_VULNERABILITY"

    # Default fallback
    return "RELATIONSHIP"


def map_graph_elements(records):
    """
    Convert Neo4j query results to Cytoscape elements with:
    - auto node type
    - auto edge type
    - theme-ready metadata
    """
    nodes = {}
    edges = []

    for rec in records:
        src_id = rec.get("src")
        dst_id = rec.get("dst")
        rel_type = rec.get("rel")

        # Build node entries
        if src_id not in nodes:
            src_type = classify_node(src_id)
            nodes[src_id] = {"data": {"id": src_id, "label": src_type}}

        if dst_id and dst_id not in nodes:
            dst_type = classify_node(dst_id)
            nodes[dst_id] = {"data": {"id": dst_id, "label": dst_type}}

        # Build edges
        if dst_id:
            src_type = nodes[src_id]["data"]["label"]
            dst_type = nodes[dst_id]["data"]["label"]

            edge_type = classify_edge(rel_type, src_type, dst_type)

            edges.append({
                "data": {
                    "source": src_id,
                    "target": dst_id,
                    "type": edge_type
                }
            })

    # Final combined structure
    return list(nodes.values()) + edges


