# ----------------------------------------------------------
# Helper: Extract IPv4 + CIDR from uploaded file
# ----------------------------------------------------------
def extract_ips(text):
    import re
    pattern = r"\b(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?\b"
    return re.findall(pattern, text)


# ----------------------------------------------------------
# Callback: Load uploaded subnet/IP text file
# ----------------------------------------------------------
@app.callback(
    Output("uploaded-ip-preview", "children"),
    Input("upload-ip-file", "contents"),
    State("upload-ip-file", "filename"),
    prevent_initial_call=True
)
def process_uploaded_ip_file(contents, filename):
    if contents is None:
        raise PreventUpdate

    import base64

    content_type, content_string = contents.split(",")
    decoded = base64.b64decode(content_string).decode("utf-8")

    ips = extract_ips(decoded)
    if not ips:
        return "⚠️ No valid IPs or subnets found."

    return f"📄 Uploaded: {filename}\n🔍 Parsed Targets:\n" + "\n".join(ips)


# ----------------------------------------------------------
# Callback: Run scan using UPLOADED IP list
# ----------------------------------------------------------
@app.callback(
    Output("upload-scan-status", "children"),
    Input("button-start-scan", "n_clicks"),
    State("uploaded-ip-preview", "children"),
    prevent_initial_call=True
)
def run_uploaded_scan(n, preview_text):
    if not n:
        raise PreventUpdate

    if not preview_text:
        return "⚠️ No uploaded targets detected."

    # Extract IPs again
    ips = extract_ips(preview_text)
    if not ips:
        return "⚠️ Could not detect IPs."

    targets = ips
    timestamp = int(time.time())
    xml_output = f"/root/vuln_intel/scans/nmap_scan_{timestamp}.xml"

    cmd = ["nmap", "-A", "-sV", "-sC", "-O", "-oX", xml_output] + targets

    try:
        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        verbose = ""

        for line in process.stdout:
            verbose += line

        process.wait()

        parsed = parse_nmap_xml(xml_output)
        save_scan_to_database(parsed)

        import_nmap_hosts_to_neo4j(parsed)

        return html.Pre(
            f"✅ Scan Completed!\nTargets: {targets}\nFile: {xml_output}\n\n{verbose}",
            style={"color": "#EAAA00"}
        )

    except Exception as e:
        return f"❌ Error: {str(e)}"


# ----------------------------------------------------------
# Callback: Manual scanner input (Normal Scan)
# ----------------------------------------------------------
@app.callback(
    Output("scan-status", "children"),
    Input("scan-btn", "n_clicks"),
    State("scanner-select", "value"),
    State("target-ip", "value"),
    prevent_initial_call=True
)
def trigger_scan(n, scanner, targets):
    if not targets:
        return "⚠️ Please provide target IP(s)."

    parsed_targets = [t.strip() for t in targets.replace(",", " ").split() if t.strip()]
    timestamp = int(time.time())
    xml_output = f"/root/vuln_intel/scans/nmap_scan_{timestamp}.xml"

    if scanner == "nmap":
        cmd = ["nmap", "-sV", "-O", "-oX", xml_output] + parsed_targets
    else:
        return f"⚠️ Scanner '{scanner}' not yet implemented."

    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        verbose = ""

        for line in p.stdout:
            verbose += line

        p.wait()

        parsed = parse_nmap_xml(xml_output)
        save_scan_to_database(parsed)
        import_nmap_hosts_to_neo4j(parsed)

        return html.Pre(
            f"✅ Scan Complete!\nTargets: {parsed_targets}\nSaved: {xml_output}\n\n{verbose}",
            style={"color": "#EAAA00"}
        )

    except Exception as e:
        return f"❌ Scan Error: {str(e)}"


