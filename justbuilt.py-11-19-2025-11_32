# UNIVERSAL GRAPH GENERATOR
# ----------------------------------------------------------
@app.callback(
    Output("graph-view", "elements"),
    Output("graph-status", "children"),
    Input("graph-generate-btn", "n_clicks"),
    State("graph-category", "value"),
    State("graph-type", "value"),
    prevent_initial_call=True
)
def run_graph_engine(n, category, gtype):
    if not gtype:
        return [], "⚠️ Select a graph type."

    try:
        query = GRAPH_QUERIES.get(gtype)
        if not query:
            return [], f"❗ No query defined for: {gtype}"

        uri = "bolt://localhost:7687"
        driver = GraphDatabase.driver(uri, auth=("neo4j", "Adomaa12@"))

        nodes = []
        edges = []

        with driver.session() as session:
            results = session.run(query)

            for record in results:
                for key, val in record.items():

                    # Node objects
                    if hasattr(val, "labels"):
                        nid = val.element_id
                        label = list(val.labels)[0]
                        nodes.append({
                            "data": {"id": nid, "label": label, "name": val.get("name", val.get("host", nid))}
                        })

                    # Relationship objects
                    elif hasattr(val, "type"):
                        src = val.start_node.element_id
                        dst = val.end_node.element_id
                        edges.append({"data": {"source": src, "target": dst}})

        # Deduplicate nodes
        unique_nodes = {n["data"]["id"]: n for n in nodes}
        elements = list(unique_nodes.values()) + edges

        if not elements:
            return [], "⚠️ No data returned."

        return elements, f"✅ Graph Loaded: {gtype}"

    except Exception as e:
        return [], f"❌ Neo4j Error: {str(e)}"


