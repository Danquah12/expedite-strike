def load_findings():
    """Load vulnerability findings from SQLite with safe fallback."""
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql_query(
            "SELECT * FROM findings ORDER BY id DESC LIMIT 2000",
            conn
        )
        conn.close()

        # Standardize column names
        df = df.rename(columns={
            "asset": "Asset",
            "host": "Asset",
            "service": "Service",
            "port": "Port",
            "cve": "CVE",
            "severity": "Severity",
            "cvss": "CVSS",
            "description": "Description",
        })

        print(f"[+] Loaded {len(df)} findings from SQLite")
        return df

    except Exception as e:
        print(f"❌ SQLite error: {e}")
        return pd.DataFrame(columns=[
            "Asset", "Service", "Port", "CVE", "Severity", "CVSS", "Description"
        ])

# ==========================================================
#  HELPER: PARSE NMAP XML → PYTHON STRUCTURE
# ==========================================================
def parse_nmap_xml(xml_path):
    """Parse Nmap XML output and extract services, ports, versions."""
    if not os.path.exists(xml_path):
        return []

    results = []
    tree = ET.parse(xml_path)
    root = tree.getroot()

    for host in root.findall("host"):
        # IP address
        addr_tag = host.find("address")
        ip = addr_tag.get("addr") if addr_tag is not None else "Unknown"

        # Hostname
        hn_tag = host.find("hostnames/hostname")
        hostname = hn_tag.get("name") if hn_tag is not None else None

        # Ports & Services
        for port in host.findall("ports/port"):
            port_id = port.get("portid")
            protocol = port.get("protocol")

            state = port.find("state").get("state")

            svc_tag = port.find("service")
            service_name = svc_tag.get("name") if svc_tag is not None else ""
            product = svc_tag.get("product") if svc_tag is not None else ""
            version = svc_tag.get("version") if svc_tag is not None else ""

            results.append({
                "ip": ip,
                "hostname": hostname,
                "port": port_id,
                "protocol": protocol,
                "state": state,
                "service": service_name,
                "product": product,
                "version": version,
            })

    return results

# ==========================================================
#  HELPER: SAVE NMAP RESULTS → SQLITE DATABASE
# ==========================================================
def save_scan_to_database(results):
    """Store parsed Nmap scan results into services table."""
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    # Ensure table exists
    cur.execute("""
        CREATE TABLE IF NOT EXISTS services (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            asset_ip TEXT,
            hostname TEXT,
            port TEXT,
            protocol TEXT,
            state TEXT,
            service TEXT,
            product TEXT,
            version TEXT
        )
    """)

    for r in results:
        cur.execute("""
            INSERT INTO services (asset_ip, hostname, port, protocol, state, service, product, version)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            r["ip"], r["hostname"],
            r["port"], r["protocol"],
            r["state"], r["service"],
            r["product"], r["version"]
        ))

    conn.commit()
    conn.close()
    print(f"[+] Inserted {len(results)} service records")

