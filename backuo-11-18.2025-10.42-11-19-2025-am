def parse_nmap_xml(xml_path):
    if not os.path.exists(xml_path):
        return {"error": "XML file does not exist"}

    results = []

    tree = ET.parse(xml_path)
    root = tree.getroot()

    for host in root.findall("host"):
        address = host.find("address").get("addr")

        # Extract hostname if present
        hostname = None
        hname_tag = host.find("hostnames/hostname")
        if hname_tag is not None:
            hostname = hname_tag.get("name")

        # Extract open ports + service banners
        for port in host.findall("ports/port"):
            port_id = port.get("portid")
            proto = port.get("protocol")

            state = port.find("state").get("state")
            service = port.find("service")

            service_name = service.get("name") if service is not None else ""
            product = service.get("product") if service is not None else ""
            version = service.get("version") if service is not None else ""

            results.append({
                "ip": address,
                "hostname": hostname,
                "port": port_id,
                "protocol": proto,
                "state": state,
                "service": service_name,
                "product": product,
                "version": version
            })

    return results


def save_scan_to_database(results):
    import sqlite3

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    # Ensure table exists
    cur.execute("""
        CREATE TABLE IF NOT EXISTS services (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            asset_ip TEXT,
            hostname TEXT,
            port TEXT,
            protocol TEXT,
            state TEXT,
            service TEXT,
            product TEXT,
            version TEXT
        )
    """)

    for r in results:
        cur.execute("""
            INSERT INTO services (asset_ip, hostname, port, protocol, state, service, product, version)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            r.get("ip"),
            r.get("hostname"),
            r.get("port"),
            r.get("protocol"),
            r.get("state"),
            r.get("service"),
            r.get("product"),
            r.get("version"),
        ))

    conn.commit()
    conn.close()

