# ==========================================================

@app.callback(
    Output("graph-type", "options"),
    Input("graph-category", "value")
)
def update_graph_type(category):
    if not category:
        return []
    return [{"label": t, "value": t} for t in GRAPH_DEFINITIONS[category]]


# ==========================================================
#  GENERATE GRAPH (PLACEHOLDER)
# ==========================================================

@app.callback(
    Output("graph-view", "elements"),
    Output("graph-status", "children"),
    Input("graph-generate-btn", "n_clicks"),
    State("graph-category", "value"),
    State("graph-type", "value")
)
def build_graph(n, category, gtype):
    if not n:
        raise PreventUpdate

    if not category or not gtype:
        return [], "❗ Select both category and graph type."

    return [], f"✅ Graph generated for: {gtype}"




