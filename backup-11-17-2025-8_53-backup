# L250+
@app.callback(
    [Output("metric-assets", "children"),
     Output("metric-services", "children"),
     Output("metric-vulns", "children"),
     Output("vuln-graph", "elements"),
     Output("vuln-table", "data")],
    [Input("tabs", "value"), Input("nessus-refresh", "n_clicks")],
    prevent_initial_call=False
)
def update_vuln_dashboard(tab, refresh_clicks):
    if tab != "tab2" and not refresh_clicks:
        raise PreventUpdate

    from neo4j import GraphDatabase
    uri = "bolt://localhost:7687"
    user = "neo4j"
    password = "Adomaa12@"

    assets, services, vulns = set(), set(), set()
    nodes, edges = [], []
    table_data = []

    try:
        driver = GraphDatabase.driver(uri, auth=(user, password))
        with driver.session() as session:
            q = """
            MATCH (a:Asset)-[:RUNS_SERVICE]->(s:Service)
            OPTIONAL MATCH (s)-[r:HAS_VULNERABILITY]->(v:Vulnerability)
            RETURN a.host AS asset, s.name AS service, s.port AS port, v.id AS vuln, r.cvss AS cvss
            """
            results = session.run(q)
            for rec in results:
                a, s, p, v, cvss = rec["asset"], rec["service"], rec["port"], rec["vuln"], rec.get("cvss", 0)

                if a: assets.add(a)
                if s: services.add(s)
                if v: vulns.add(v)

                if a and s:
                    nodes.append({'data': {'id': a, 'label': 'Asset'}})
                    sid = f"{s}:{p}"
                    nodes.append({'data': {'id': sid, 'label': 'Service'}})
                    edges.append({'data': {'source': a, 'target': sid}})

                if v:
                    nodes.append({'data': {'id': v, 'label': 'Vulnerability'}})
                    edges.append({'data': {'source': f"{s}:{p}", 'target': v, 'cvss': cvss}})

                table_data.append({
                    "Asset": a, "Service": s, "Port": p, "Vulnerability": v or "None"
                })
        driver.close()

    except Exception as e:
        print(f"[!] Neo4j connection or query failed: {e}")
        return "0", "0", "0", [], []

    # Deduplicate nodes
    seen = {}
    for n in nodes:
        nid = n["data"]["id"]
        if nid not in seen:
            seen[nid] = n
    elements = list(seen.values())
    elements.extend(edges)

    if not elements:
        print("[!] No data found in Neo4j graph.")
        return "0", "0", "0", [], []

    print(f"[+] Dashboard updated: {len(assets)} assets, {len(services)} services, {len(vulns)} vulns.")
    return str(len(assets)), str(len(services)), str(len(vulns)), elements, table_data


