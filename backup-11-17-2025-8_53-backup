        if tab == "tab1":
            if 'system_health_layout' in globals():
                return system_health_layout()
            else:
                return html.Div("⚠️ system_health_layout() not found", style={"color": "orange"})
        elif tab == "tab2":
            if 'vulnerability_tab' in globals():
